model ProductionBatch {
  id                       String                @id @default(uuid()) @db.Uuid
  wineryId                 String                @map("winery_id") @db.Uuid
  fermentationTankId       String                @map("fermentation_tank_id") @db.Uuid
  processType              ProductionProcessEnum @map("process_type")
  equipmentIdentifier      String                @map("equipment_identifier") @db.VarChar(100)
  processStartDate         DateTime              @map("process_start_date") @db.Date
  processEndDate           DateTime?             @map("process_end_date") @db.Date
  inputVolumeLiters        Decimal?              @map("input_volume_liters") @db.Decimal(10, 3)
  outputVolumeLiters       Decimal?              @map("output_volume_liters") @db.Decimal(10, 3)
  wasteVolumeLiters        Decimal?              @map("waste_volume_liters") @db.Decimal(10, 3)
  initialAlcoholPercentage Decimal?              @map("initial_alcohol_percentage") @db.Decimal(5, 2)
  isDoEligible             Boolean               @default(false) @map("is_do_eligible")
  mandatoryRestUntil       DateTime?             @map("mandatory_rest_until") @db.Date
  restStatus               RestStatusEnum        @default(NOT_REQUIRED) @map("rest_status")
  additionalParams         Json?                 @map("additional_params")
  notes                    String?               @db.Text
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                    String                @map("lot_id") @db.Uuid
  /// Cortes del cierre (Ola 2); los legados quedan en `additionalParams`
  headsLiters              Decimal?              @map("heads_liters") @db.Decimal(10, 3)
  heartLiters              Decimal?              @map("heart_liters") @db.Decimal(10, 3)
  tailsLiters              Decimal?              @map("tails_liters") @db.Decimal(10, 3)
  vinasseLiters            Decimal?              @map("vinasse_liters") @db.Decimal(10, 3)
  heartAbvPercent          Decimal?              @map("heart_abv_percent") @db.Decimal(5, 2)
  discardedAt              DateTime?             @map("discarded_at") @db.Timestamptz(6)
  discardReason            String?               @map("discard_reason") @db.Text
  createdByMembershipId    String?               @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery           Winery           @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Restrict)
  lot              Lot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bottlingBatches  BottlingBatch[]

  @@index([lotId])
  @@index([wineryId])
  @@index([fermentationTankId])
  @@map("production_batches")
}

model BottlingBatch {
  id                          String           @id @default(uuid()) @db.Uuid
  wineryId                    String           @map("winery_id") @db.Uuid
  wineAgingBatchId            String?          @map("wine_aging_batch_id") @db.Uuid
  productionBatchId           String?          @map("production_batch_id") @db.Uuid
  productType                 BeverageTypeEnum @map("product_type")
  internationalLotCode        String           @unique @map("international_lot_code") @db.VarChar(100)
  finalAlcoholAbv             Decimal          @map("final_alcohol_abv") @db.Decimal(5, 2)
  waterDilutionLiters         Decimal?         @map("water_dilution_liters") @db.Decimal(10, 3)
  totalBottlesPackaged        Int              @map("total_bottles_packaged")
  packagingFormatCl           Int              @map("packaging_format_cl")
  bottleType                  String?          @map("bottle_type") @db.VarChar(100)
  labelDesignUrl              String?          @map("label_design_url") @db.VarChar(500)
  bottlingDate                DateTime         @map("bottling_date") @db.Date
  releasedByMemberId          String?          @map("released_by_member_id") @db.Uuid
  blockchainAnchorTxHash      String?          @map("blockchain_anchor_tx_hash") @db.VarChar(100)
  blockchainDataHash          String?          @map("blockchain_data_hash") @db.Char(64)
  isAnchoredOnChain           Boolean          @default(false) @map("is_anchored_on_chain")
  anchoredAt                  DateTime?        @map("anchored_at") @db.Timestamptz(6)
  /// Hash de anclaje **simulado** anterior al paso 3.5 (nunca estuvo en la red)
  legacySimulatedAnchorTxHash String?          @map("legacy_simulated_anchor_tx_hash") @db.VarChar(100)
  qrBatchUrl                  String?          @map("qr_batch_url") @db.VarChar(500)
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Un embotellado por lote (S-10): restricción única
  lotId                       String           @unique @map("lot_id") @db.Uuid
  availableLiters             Decimal?         @map("available_liters") @db.Decimal(12, 3)
  leftoverLiters              Decimal?         @map("leftover_liters") @db.Decimal(12, 3)
  leftoverDisposition         String?          @map("leftover_disposition") @db.VarChar(20)
  leftoverNotes               String?          @map("leftover_notes") @db.Text
  labelDesignKey              String?          @map("label_design_key") @db.VarChar(500)
  createdByMembershipId       String?          @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery           Winery             @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  wineAgingBatch   WineAgingBatch?    @relation(fields: [wineAgingBatchId], references: [id], onDelete: Restrict)
  productionBatch  ProductionBatch?   @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  releasedByMember WineryMember?      @relation(fields: [releasedByMemberId], references: [id], onDelete: Restrict)
  lot              Lot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  /// Todos los análisis (reanálisis); el vigente es el último sin `supersededAt`
  labAnalyses      BatchLabAnalysis[]
  bottleUnits      BottleUnit[]

  @@index([wineryId, bottlingDate])
  @@index([wineAgingBatchId])
  @@index([productionBatchId])
  @@map("bottling_batches")
}

model BatchLabAnalysis {
  id                             String    @id @default(uuid()) @db.Uuid
  bottlingBatchId                String    @map("bottling_batch_id") @db.Uuid
  certifiedLaboratoryName        String    @map("certified_laboratory_name") @db.VarChar(300)
  accreditedLabCertificationCode String    @map("accredited_lab_certification_code") @db.VarChar(100)
  analysisRequestDate            DateTime? @map("analysis_request_date") @db.Date
  testPerformedAt                DateTime  @map("test_performed_at") @db.Date
  actualAlcoholAbv               Decimal   @map("actual_alcohol_abv") @db.Decimal(5, 2)
  totalAlcoholAbv                Decimal?  @map("total_alcohol_abv") @db.Decimal(5, 2)
  totalAcidityTartaricGl         Decimal   @map("total_acidity_tartaric_gl") @db.Decimal(6, 3)
  volatileAcidityAceticGl        Decimal   @map("volatile_acidity_acetic_gl") @db.Decimal(6, 3)
  freeSulfurDioxideMgL           Decimal?  @map("free_sulfur_dioxide_mg_l") @db.Decimal(7, 3)
  totalSulfurDioxideMgL          Decimal?  @map("total_sulfur_dioxide_mg_l") @db.Decimal(7, 3)
  reducingSugarsGl               Decimal?  @map("reducing_sugars_gl") @db.Decimal(7, 3)
  totalDryExtractGl              Decimal?  @map("total_dry_extract_gl") @db.Decimal(7, 3)
  sugarFreeDryExtractGl          Decimal?  @map("sugar_free_dry_extract_gl") @db.Decimal(7, 3)
  overpressureBar                Decimal?  @map("overpressure_bar") @db.Decimal(5, 2)
  methanolContentMgL             Decimal?  @map("methanol_content_mg_l") @db.Decimal(7, 3)
  copperContentMgL               Decimal?  @map("copper_content_mg_l") @db.Decimal(7, 3)
  additionalParams               Json?     @map("additional_params")
  laboratoryReportPdfUrl         String    @map("laboratory_report_pdf_url") @db.VarChar(500)
  conformsToSenasagStandards     Boolean   @default(false) @map("conforms_to_senasag_standards")
  conformsToEuStandards          Boolean   @default(false) @map("conforms_to_eu_standards")
  conformsToUsaStandards         Boolean   @default(false) @map("conforms_to_usa_standards")
  reviewedByMemberId             String?   @map("reviewed_by_member_id") @db.Uuid
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                          String    @map("lot_id") @db.Uuid
  /// Metanol en mg/100 mL de alcohol anhidro (calculado si solo llega mg/L)
  methanolMg100mlAa              Decimal?  @map("methanol_mg_100ml_aa") @db.Decimal(9, 3)
  /// Conformidad calculada contra la instantánea del lote (`LabConformity`)
  conformity                     Json?     @db.JsonB
  conformityStatus               String?   @map("conformity_status") @db.VarChar(20)
  /// Sustituido por un análisis posterior (reanálisis)
  supersededAt                   DateTime? @map("superseded_at") @db.Timestamptz(6)
  laboratoryReportKey            String?   @map("laboratory_report_key") @db.VarChar(500)
  /// SHA-256 (hexadecimal) del informe subido, calculado al registrar el análisis
  laboratoryReportSha256         String?   @map("laboratory_report_sha256") @db.Char(64)
  createdByMembershipId          String?   @map("created_by_membership_id") @db.Uuid
  /// Anulado por una corrección `VOID` (§9): deja de contar
  voidedAt                       DateTime? @map("voided_at") @db.Timestamptz(6)

  // Relaciones
  bottlingBatch    BottlingBatch @relation(fields: [bottlingBatchId], references: [id], onDelete: Restrict)
  reviewedByMember WineryMember? @relation(fields: [reviewedByMemberId], references: [id], onDelete: Restrict)
  lot              Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([bottlingBatchId, createdAt])
  @@index([lotId])
  @@map("batch_lab_analyses")
}

// -----------------------------------------------------------------------------
// LOTE Y TRAZABILIDAD CONFIABLE (Ola 2; plan/contratos/o2-erp-confiable.md)
// El lote agrupa la cadena. Solo inserción: los errores se corrigen con
// registros compensatorios (`trace_corrections`). Los actores se guardan por
// su membresía (`*_membership_id`, sin clave foránea, como en la bitácora).
// -----------------------------------------------------------------------------
enum LotStageEnum {
  ORIGIN
  HARVEST
  FERMENTING
  AGING
  DISTILLING
  RESTING
  BOTTLED
  CERTIFIED
  ANCHORED
  REJECTED
  DISCARDED

  @@map("lot_stage_enum")
}

enum LotProductTypeEnum {
  WINE
  SINGANI

  @@map("lot_product_type_enum")
}

enum BottleUnitStatusEnum {
  ACTIVE
  VOIDED

  @@map("bottle_unit_status_enum")
}

model Lot {
  id                      String              @id @default(uuid()) @db.Uuid
  wineryId                String              @map("winery_id") @db.Uuid
  /// Interno, desde la creación: `{lotPrefix}-L{año}-{NNN}`
  reference               String              @unique @db.VarChar(40)
  /// Código de lote de la etiqueta (= `bottling_batches.international_lot_code`)
  lotCode                 String?             @unique @map("lot_code") @db.VarChar(100)
  name                    String              @db.VarChar(120)
  productType             LotProductTypeEnum? @map("product_type")
  stage                   LotStageEnum        @default(ORIGIN)
  stageChangedAt          DateTime            @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  harvestYear             Int                 @map("harvest_year") @db.SmallInt
  estimatedBottles        Int?                @map("estimated_bottles")
  plannedFormatCl         Int?                @map("planned_format_cl")
  targetAbvPercent        Decimal?            @map("target_abv_percent") @db.Decimal(5, 2)
  targetReadyDate         DateTime?           @map("target_ready_date") @db.Date
  plannedTerroirIds       String[]            @default([]) @map("planned_terroir_ids") @db.Uuid
  /// Instantánea de reglas (`LotRules`, CFG-06): no se edita nunca
  rules                   Json                @db.JsonB
  /// `LOT_CREATION` | `MIGRATION`
  rulesOrigin             String              @map("rules_origin") @db.VarChar(20)
  notes                   String?             @db.Text
  discardedAt             DateTime?           @map("discarded_at") @db.Timestamptz(6)
  discardedByMembershipId String?             @map("discarded_by_membership_id") @db.Uuid
  discardReason           String?             @map("discard_reason") @db.Text
  createdByMembershipId   String?             @map("created_by_membership_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery               Winery                @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  harvestBatches       HarvestBatch[]
  fermentationTanks    FermentationTank[]
  wineAgingBatches     WineAgingBatch[]
  productionBatches    ProductionBatch[]
  bottlingBatch        BottlingBatch?
  labAnalyses          BatchLabAnalysis[]
  events               LotEvent[]
  bottleUnits          BottleUnit[]
  bottleCodeExports    BottleCodeExport[]
  corrections          TraceCorrection[]
  complianceIssues     LotComplianceIssue[]
  attachments          LotAttachment[]
  dossier              LotDossier?
  tokenizationRequests TokenizationRequest[]
  collection           Collection?
  lotClosure           LotClosure?

  @@index([wineryId, stage])
  @@index([wineryId, updatedAt])
  @@map("lots")
}

/// Línea de tiempo del lote (§11.1): un evento por escritura, en la misma transacción.
model LotEvent {
  id                String       @id @default(uuid()) @db.Uuid
  lotId             String       @map("lot_id") @db.Uuid
  seq               Int
  type              String       @db.VarChar(40)
  occurredAt        DateTime     @map("occurred_at") @db.Timestamptz(6)
  recordedAt        DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  stage             LotStageEnum
  actorMembershipId String?      @map("actor_membership_id") @db.Uuid
  summary           String       @db.Text
  data              Json         @default("{}") @db.JsonB
  resourceType      String       @map("resource_type") @db.VarChar(40)
  resourceId        String       @map("resource_id") @db.VarChar(100)
  /// `PUBLIC` | `INTERNAL`
  visibility        String       @default("INTERNAL") @db.VarChar(10)
  corrected         Boolean      @default(false)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([lotId, seq])
  @@index([lotId, occurredAt])
  @@map("lot_events")
}

/// Secuencias por bodega, año y ámbito (EA-07): `INSERT … ON CONFLICT DO
/// UPDATE … RETURNING` (bloqueo de fila). Ámbitos: `HARVEST` (código de
/// vendimia), `LOT_CODE` (código de lote de la etiqueta), `LOT_REFERENCE`.
model LotSequence {
  wineryId  String   @map("winery_id") @db.Uuid
  year      Int      @db.SmallInt
  scope     String   @db.VarChar(30)
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery Winery @relation(fields: [wineryId], references: [id], onDelete: Restrict)

  @@id([wineryId, year, scope])
  @@map("lot_sequences")
}

/// Dictamen fitosanitario (§3.4, EA-04): solo inserción; el estado del pesaje es el del último.
model PhytoDecision {
  id                     String          @id @default(uuid()) @db.Uuid
  harvestBatchId         String          @map("harvest_batch_id") @db.Uuid
  decision               PhytoStatusEnum
  decidedAt              DateTime        @map("decided_at") @db.Timestamptz(6)
  recordedAt             DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  decidedByMembershipId  String?         @map("decided_by_membership_id") @db.Uuid
  inspectionReportKey    String?         @map("inspection_report_key") @db.VarChar(500)
  inspectionReportSha256 String?         @map("inspection_report_sha256") @db.Char(64)
  notes                  String?         @db.Text
  /// `ERP` | `MIGRATION`
  source                 String          @default("ERP") @db.VarChar(20)
  voidedAt               DateTime?       @map("voided_at") @db.Timestamptz(6)

  harvestBatch HarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@index([harvestBatchId, recordedAt])
  @@map("phyto_decisions")
}

/// Análisis de madurez (§3.3): solo inserción; el último es el vigente.
model MaturityAnalysis {
  id                     String    @id @default(uuid()) @db.Uuid
  harvestBatchId         String    @map("harvest_batch_id") @db.Uuid
  brixDegrees            Decimal   @map("brix_degrees") @db.Decimal(5, 2)
  ph                     Decimal   @db.Decimal(4, 2)
  acidityGl              Decimal   @map("acidity_gl") @db.Decimal(6, 3)
  measuredAt             DateTime  @map("measured_at") @db.Timestamptz(6)
  recordedAt             DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedByMembershipId String?   @map("recorded_by_membership_id") @db.Uuid
  notes                  String?   @db.Text
  /// `ERP` | `MIGRATION`
  source                 String    @default("ERP") @db.VarChar(20)
  voidedAt               DateTime? @map("voided_at") @db.Timestamptz(6)

  harvestBatch HarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@index([harvestBatchId, measuredAt])
  @@map("maturity_analyses")
}

/// Entradas de uva a un tanque (§4.1): kilos de cada pesaje.
model FermentationTankInput {
  id                 String   @id @default(uuid()) @db.Uuid
  fermentationTankId String   @map("fermentation_tank_id") @db.Uuid
  harvestBatchId     String   @map("harvest_batch_id") @db.Uuid
  kg                 Decimal  @db.Decimal(12, 3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Restrict)
  harvestBatch     HarvestBatch     @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@unique([fermentationTankId, harvestBatchId])
  @@index([harvestBatchId])
  @@map("fermentation_tank_inputs")
}

/// Código de botella (§7, A-26): 8 caracteres Crockford (7 aleatorios + control Luhn mod 32).
model BottleUnit {
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique @db.Char(8)
  serial               Int
  lotId                String               @map("lot_id") @db.Uuid
  bottlingBatchId      String               @map("bottling_batch_id") @db.Uuid
  status               BottleUnitStatusEnum @default(ACTIVE)
  /// Sal aleatoria de la hoja Merkle del expediente (16 bytes en hex)
  salt                 String               @db.Char(32)
  voidedAt             DateTime?            @map("voided_at") @db.Timestamptz(6)
  voidedByMembershipId String?              @map("voided_by_membership_id") @db.Uuid
  voidReason           String?              @map("void_reason") @db.Text
  replacedByCode       String?              @map("replaced_by_code") @db.Char(8)
  replacesCode         String?              @map("replaces_code") @db.Char(8)
  exportsCount         Int                  @default(0) @map("exports_count")
  firstExportedAt      DateTime?            @map("first_exported_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bottlingBatch BottlingBatch @relation(fields: [bottlingBatchId], references: [id], onDelete: Restrict)

  @@index([lotId, serial])
  @@index([lotId, status])
  @@index([bottlingBatchId, status])
  @@map("bottle_units")
}

/// Exportación de códigos para la imprenta (§7.2): ZIP generado en el worker.
model BottleCodeExport {
  id                    String    @id @default(uuid()) @db.Uuid
  lotId                 String    @map("lot_id") @db.Uuid
  format                String    @db.VarChar(10)
  fromSerial            Int?      @map("from_serial")
  toSerial              Int?      @map("to_serial")
  options               Json      @default("{}") @db.JsonB
  /// `PENDING` | `READY` | `FAILED`
  status                String    @default("PENDING") @db.VarChar(10)
  rows                  Int       @default(0)
  storageKey            String?   @map("storage_key") @db.VarChar(500)
  error                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@map("bottle_code_exports")
}

/// Corrección compensatoria (§9, EA-06): el original nunca se pierde.
model TraceCorrection {
  id                    String   @id @default(uuid()) @db.Uuid
  lotId                 String?  @map("lot_id") @db.Uuid
  wineryId              String   @map("winery_id") @db.Uuid
  targetType            String   @map("target_type") @db.VarChar(30)
  targetId              String   @map("target_id") @db.Uuid
  /// `AMEND` | `VOID`
  kind                  String   @db.VarChar(10)
  changes               Json     @default("[]") @db.JsonB
  reason                String   @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@index([targetType, targetId])
  @@map("trace_corrections")
}

/// Incidencia de cumplimiento (§2.6.8): bloquea embotellar y cerrar el expediente.
model LotComplianceIssue {
  id                     String    @id @default(uuid()) @db.Uuid
  lotId                  String    @map("lot_id") @db.Uuid
  code                   String    @db.VarChar(60)
  message                String    @db.Text
  /// `MIGRATION` | `CORRECTION` | `RULES_REEVALUATION`
  source                 String    @db.VarChar(30)
  details                Json      @default("[]") @db.JsonB
  detectedAt             DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByCorrectionId String?   @map("resolved_by_correction_id") @db.Uuid

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, resolvedAt])
  @@map("lot_compliance_issues")
}

/// Archivo privado o público del lote (§11.5).
model LotAttachment {
  id                    String   @id @default(uuid()) @db.Uuid
  lotId                 String   @map("lot_id") @db.Uuid
  kind                  String   @db.VarChar(20)
  title                 String   @db.VarChar(200)
  key                   String   @db.VarChar(500)
  mimeType              String?  @map("mime_type") @db.VarChar(100)
  sizeBytes             Int?     @map("size_bytes")
  sha256                String?  @db.Char(64)
  /// `PRIVATE` | `PUBLIC`
  visibility            String   @default("PRIVATE") @db.VarChar(10)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@map("lot_attachments")
}

/// Expediente del lote (§10): hash SHA-256 del JSON canónico (RFC 8785).
model LotDossier {
  lotId                String    @id @map("lot_id") @db.Uuid
  schema               String    @default("doc-dossier/1") @db.VarChar(30)
  /// `OPEN` | `CLOSED`
  status               String    @default("OPEN") @db.VarChar(10)
  hash                 String?   @db.Char(64)
  canonical            String?   @db.Text
  bottleCount          Int?      @map("bottle_count")
  bottleMerkleRoot     String?   @map("bottle_merkle_root") @db.Char(64)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId String?   @map("closed_by_membership_id") @db.Uuid

  lot    Lot            @relation(fields: [lotId], references: [id], onDelete: Restrict)
  anchor DossierAnchor?

  @@map("lot_dossiers")
}

/// Pesajes anteriores a la Ola 2 pendientes de su lote (relleno §2.6): la
/// migración los encola y la API los procesa al arrancar (`LotBackfillRunner`).
model LotBackfillPending {
  harvestBatchId String   @id @map("harvest_batch_id") @db.Uuid
  enqueuedAt     DateTime @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  attempts       Int      @default(0)
  lastError      String?  @map("last_error") @db.Text

  @@map("lot_backfill_pending")
}

// -----------------------------------------------------------------------------
// CADENA Y TOKENIZACIÓN (Ola 3; plan/contratos/o3-tokenizacion.md §1)
// Estados y tipos como texto (los valores viven en `src/modules/chain` y
// `src/modules/tokenization`). Lo que registra hechos (transacciones,
// intentos, eventos, historiales) es de solo inserción. Los actores se guardan
// por su id, sin clave foránea, como en la bitácora. Los índices parciales y
// las restricciones `CHECK` están en la migración `o3_cadena_expand`
// (Prisma no los expresa).
// -----------------------------------------------------------------------------

/// Cuenta en la red (§2.1): de la plataforma (`OPERATIONS`, `ANCHOR`,
/// `CONSUMER_SEED`) o de una bodega (`WINERY`, una por bodega y red). La clave
/// nunca está aquí: `custodyKeyRef` la nombra en el custodio.
model ChainAccount {
  id              String    @id @default(uuid()) @db.Uuid
  /// `OPERATIONS` | `ANCHOR` | `WINERY` | `CONSUMER_SEED`
  role            String    @db.VarChar(20)
  /// `TESTNET` | `PUBLIC` | `LOCAL`
  network         String    @db.VarChar(10)
  wineryId        String?   @map("winery_id") @db.Uuid
  /// StrKey `G…`; `null` hasta que el custodio crea la clave
  address         String?   @db.VarChar(56)
  /// `platform-operations` | `platform-anchor` | `winery-{wineryId}` | `consumer-master-seed`
  custodyKeyRef   String    @map("custody_key_ref") @db.VarChar(100)
  /// Driver `ENV`: índice SEP-0005 de la clave de la bodega (S-1); nunca se reutiliza
  derivationIndex Int?      @map("derivation_index")
  homeDomain      String?   @map("home_domain") @db.VarChar(255)
  /// Identidad (§3.1): `NOT_PROVISIONED` | `PROVISIONING` | `ACTIVE` | `FAILED` | `PAUSED`
  status          String    @default("NOT_PROVISIONED") @db.VarChar(20)
  lastError       Json?     @map("last_error") @db.JsonB
  /// `chain_transactions.id` de `CREATE_WINERY_ACCOUNT`
  createdTxId     String?   @map("created_tx_id") @db.Uuid
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery    Winery?       @relation("WineryChainAccounts", fields: [wineryId], references: [id], onDelete: Restrict)
  currentOf Winery?       @relation("WineryCurrentChainAccount")
  contracts NftContract[]

  @@unique([network, address])
  @@unique([network, custodyKeyRef])
  @@unique([network, derivationIndex])
  @@unique([wineryId, network])
  @@index([role, network])
  @@map("chain_accounts")
}

/// Contrato NFT de una bodega (§3.1): uno vigente por bodega y red.
model NftContract {
  id              String    @id @default(uuid()) @db.Uuid
  wineryId        String    @map("winery_id") @db.Uuid
  chainAccountId  String    @map("chain_account_id") @db.Uuid
  network         String    @db.VarChar(10)
  /// StrKey `C…`; `null` hasta desplegarse
  address         String?   @db.VarChar(56)
  wasmHash        String    @map("wasm_hash") @db.Char(64)
  name            String    @db.VarChar(40)
  symbol          String    @db.VarChar(10)
  baseUri         String    @map("base_uri") @db.VarChar(200)
  operatorAddress String    @map("operator_address") @db.VarChar(56)
  paused          Boolean   @default(false)
  /// `PENDING` | `ACTIVE` | `FAILED` | `RETIRED`
  status          String    @default("PENDING") @db.VarChar(12)
  /// `chain_transactions.id` de `DEPLOY_WINERY_CONTRACT`
  deployedTxId    String?   @map("deployed_tx_id") @db.Uuid
  deployedAt      DateTime? @map("deployed_at") @db.Timestamptz(6)
  /// Leído de vuelta: `get_admin`, `has_role(operator)`, `name`, `symbol`
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery       Winery       @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  chainAccount ChainAccount @relation(fields: [chainAccountId], references: [id], onDelete: Restrict)
  collections  Collection[]
  tokens       Token[]

  @@unique([network, address])
  @@index([wineryId, network])
  @@map("nft_contracts")
}

/// Intención de dominio y su transacción en la red (§2.2, §2.3).
model ChainTransaction {
  id                String    @id @default(uuid()) @db.Uuid
  /// `ChainTxKind` (§2.2)
  kind              String    @db.VarChar(30)
  /// `PENDING` | `BUILDING` | `SUBMITTED` | `CONFIRMED` | `RETRYING` | `FAILED`
  status            String    @default("PENDING") @db.VarChar(12)
  network           String    @db.VarChar(10)
  /// Idempotencia de la intención: `mint:{mintId}:{chunk}`, `anchor:{dossierId}`…
  intentKey         String    @unique @map("intent_key") @db.VarChar(200)
  /// `WINERY` | `CONTRACT` | `MINT` | `LOT` | `TOKEN` | `PLATFORM`
  subjectType       String    @map("subject_type") @db.VarChar(12)
  subjectId         String    @map("subject_id") @db.VarChar(100)
  wineryId          String?   @map("winery_id") @db.Uuid
  /// Parámetros validados (solo identificadores de dominio; sin secretos ni XDR)
  intent            Json      @default("{}") @db.JsonB
  /// Quien paga
  sourceAccount     String?   @map("source_account") @db.VarChar(56)
  /// `[{ role, address, wineryId }]`
  signers           Json      @default("[]") @db.JsonB
  txHash            String?   @map("tx_hash") @db.Char(64)
  ledger            Int?
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  attempts          Int       @default(0)
  /// `{ code, message, retryable }`
  lastError         Json?     @map("last_error") @db.JsonB
  feeChargedStroops BigInt?   @map("fee_charged_stroops")
  rentFeeStroops    BigInt?   @map("rent_fee_stroops")
  maxFeeStroops     BigInt?   @map("max_fee_stroops")
  /// `{ returnValue, contractEvents }`
  result            Json?     @db.JsonB
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// `timeBounds.maxTime` de la última construcción (idempotencia en la red, §2.3)
  maxTime           DateTime? @map("max_time") @db.Timestamptz(6)
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  requestedByName   String?   @map("requested_by_name") @db.VarChar(200)
  /// `API` | `WORKER`
  requestedSource   String    @default("WORKER") @map("requested_source") @db.VarChar(6)
  abandonedAt       DateTime? @map("abandoned_at") @db.Timestamptz(6)
  abandonedBy       String?   @map("abandoned_by") @db.VarChar(200)
  abandonReason     String?   @map("abandon_reason") @db.Text
  correlationId     String?   @map("correlation_id") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery        Winery?          @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  attemptsLog   ChainTxAttempt[]
  events        ChainEvent[]
  dossierAnchor DossierAnchor?

  @@index([status, nextAttemptAt])
  @@index([kind, status])
  @@index([wineryId, createdAt])
  @@index([subjectType, subjectId])
  @@index([txHash])
  @@index([createdAt])
  @@map("chain_transactions")
}

/// Historial de intentos de una transacción (§2.3 `history`): solo inserción.
model ChainTxAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  attempt       Int
  status        String   @db.VarChar(12)
  at            DateTime @default(now()) @db.Timestamptz(6)
  txHash        String?  @map("tx_hash") @db.Char(64)
  sequence      String?  @db.VarChar(20)
  errorCode     String?  @map("error_code") @db.VarChar(60)
  /// Código de resultado de la red o del contrato
  detail        String?  @db.Text

  transaction ChainTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, attempt])
  @@map("chain_tx_attempts")
}

/// Evento de un contrato leído por el indexador (§8.1): solo inserción.
model ChainEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  rpcEventId           String   @unique @map("rpc_event_id") @db.VarChar(100)
  network              String   @db.VarChar(10)
  contractAddress      String   @map("contract_address") @db.VarChar(56)
  wineryId             String?  @map("winery_id") @db.Uuid
  ledger               Int
  ledgerClosedAt       DateTime @map("ledger_closed_at") @db.Timestamptz(6)
  txHash               String   @map("tx_hash") @db.Char(64)
  /// Primer topic: `lot_minted`, `transfer`…
  type                 String   @db.VarChar(40)
  topics               Json     @default("[]") @db.JsonB
  data                 Json     @default("{}") @db.JsonB
  matchedTransactionId String?  @map("matched_transaction_id") @db.Uuid
  originatedBySystem   Boolean  @default(false) @map("originated_by_system")
  processedAt          DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  matchedTransaction ChainTransaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: Restrict)

  @@index([contractAddress, ledger])
  @@index([txHash])
  @@index([type, ledger])
  @@index([originatedBySystem, ledger])
  @@map("chain_events")
}

/// Cursor del indexador por red (§8.1).
model ChainCursor {
  network    String   @db.VarChar(10)
  /// `events`
  name       String   @db.VarChar(40)
  cursor     String?  @db.VarChar(200)
  lastLedger Int?     @map("last_ledger")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([network, name])
  @@map("chain_cursors")
}

/// Ejecución de la conciliación (§8.2).
model ReconciliationRun {
  id                 String    @id @default(uuid()) @db.Uuid
  /// `ALL` | `CONTRACT` | `COLLECTION`
  scope              String    @db.VarChar(12)
  subjectId          String?   @map("subject_id") @db.VarChar(100)
  /// `SCHEDULED` | `MANUAL` | `INDEXER_GAP`
  trigger            String    @db.VarChar(12)
  /// `LIGHT` | `FULL`
  depth              String    @db.VarChar(6)
  /// `RUNNING` | `OK` | `DIFFERENCES` | `ERROR`
  status             String    @default("RUNNING") @db.VarChar(12)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(6)
  checks             Int       @default(0)
  issuesOpened       Int       @default(0) @map("issues_opened")
  issuesAutoResolved Int       @default(0) @map("issues_auto_resolved")
  requestedByUserId  String?   @map("requested_by_user_id") @db.Uuid

  alerts ChainAlert[]

  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

/// Alerta de la cadena (§8.2): nunca se corrige sola; se resuelve a mano o al
/// desaparecer su condición (`resolvedAuto`).
model ChainAlert {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @db.VarChar(40)
  /// `INFO` | `WARNING` | `CRITICAL`
  level          String    @db.VarChar(10)
  subjectType    String    @map("subject_type") @db.VarChar(20)
  subjectId      String    @map("subject_id") @db.VarChar(100)
  wineryId       String?   @map("winery_id") @db.Uuid
  expected       Json?     @db.JsonB
  actual         Json?     @db.JsonB
  message        String    @db.Text
  runId          String?   @map("run_id") @db.Uuid
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by") @db.VarChar(200)
  resolutionNote String?   @map("resolution_note") @db.Text
  resolvedAuto   Boolean   @default(false) @map("resolved_auto")

  run ReconciliationRun? @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([resolvedAt, level])
  @@index([code, detectedAt])
  @@index([wineryId, detectedAt])
  @@map("chain_alerts")
}

/// Solicitud de tokenización de un lote (§5): una abierta por lote.
model TokenizationRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  wineryId                String    @map("winery_id") @db.Uuid
  lotId                   String    @map("lot_id") @db.Uuid
  /// `INITIAL` | `QUOTA_INCREASE`
  kind                    String    @db.VarChar(16)
  /// `SUBMITTED` | `IN_REVIEW` | `CHANGES_REQUESTED` | `APPROVED` | `REJECTED` | `WITHDRAWN`
  status                  String    @default("SUBMITTED") @db.VarChar(20)
  quantity                Int
  resultingQuota          Int       @map("resulting_quota")
  /// Valor de `tokenizacion.requiereAprobacion` al enviar (§5.6)
  requiresApproval        Boolean   @default(true) @map("requires_approval")
  assigneeUserId          String?   @map("assignee_user_id") @db.Uuid
  /// `CollectionCommercialInput` (§5.5)
  commercialDraft         Json      @default("{}") @map("commercial_draft") @db.JsonB
  priceAmountMinor        Int?      @map("price_amount_minor")
  priceCurrency           String?   @map("price_currency") @db.Char(3)
  /// `POLICY_SUGGESTED` | `MANUAL`
  priceSource             String?   @map("price_source") @db.VarChar(20)
  priceSetAt              DateTime? @map("price_set_at") @db.Timestamptz(6)
  priceSetByUserId        String?   @map("price_set_by_user_id") @db.Uuid
  wineryNotes             String?   @map("winery_notes") @db.Text
  /// `TokenizationLimits` al enviar
  limitsAtSubmission      Json      @default("{}") @map("limits_at_submission") @db.JsonB
  publishOnMint           Boolean   @default(false) @map("publish_on_mint")
  /// `APPROVED` | `REJECTED`
  decisionOutcome         String?   @map("decision_outcome") @db.VarChar(10)
  decisionAt              DateTime? @map("decision_at") @db.Timestamptz(6)
  decisionReason          String?   @map("decision_reason") @db.Text
  decisionByUserId        String?   @map("decision_by_user_id") @db.Uuid
  decisionBySystem        Boolean   @default(false) @map("decision_by_system")
  withdrawnAt             DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnByMembershipId String?   @map("withdrawn_by_membership_id") @db.Uuid
  withdrawReason          String?   @map("withdraw_reason") @db.Text
  collectionId            String?   @map("collection_id") @db.Uuid
  submittedAt             DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submittedByMembershipId String?   @map("submitted_by_membership_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery     Winery                      @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  lot        Lot                         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  collection Collection?                 @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  changes    TokenizationRequestChange[]
  mint       Mint?

  @@index([wineryId, status])
  @@index([status, submittedAt])
  @@index([lotId, submittedAt])
  @@index([assigneeUserId, status])
  @@map("tokenization_requests")
}

/// Historial de la solicitud: cambios de estado, peticiones de cambio, notas
/// internas y ediciones. Solo inserción (salvo `resolvedAt` de una petición).
model TokenizationRequestChange {
  id                String    @id @default(uuid()) @db.Uuid
  requestId         String    @map("request_id") @db.Uuid
  /// `STATUS` | `CHANGE_REQUEST` | `NOTE` | `EDIT`
  type              String    @db.VarChar(16)
  status            String?   @db.VarChar(20)
  message           String?   @db.Text
  fields            String[]  @default([])
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  actorUserId       String?   @map("actor_user_id") @db.Uuid
  actorMembershipId String?   @map("actor_membership_id") @db.Uuid
  actorName         String?   @map("actor_name") @db.VarChar(200)
  actorSystem       Boolean   @default(false) @map("actor_system")
  data              Json?     @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  request TokenizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("tokenization_request_changes")
}

/// Colección de un lote (§6.2): una por lote; `minted ≤ quota` (R6) en la base.
model Collection {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Generado desde `name`; único por bodega; no cambia una vez publicada
  slug                String    @db.VarChar(140)
  wineryId            String    @map("winery_id") @db.Uuid
  lotId               String    @unique @map("lot_id") @db.Uuid
  contractId          String    @map("contract_id") @db.Uuid
  /// `MINTING` | `READY` | `PUBLISHED` | `PAUSED` | `CLOSED`
  status              String    @default("MINTING") @db.VarChar(12)
  /// De la última emisión: `PENDING` | `IN_PROGRESS` | `CONFIRMED` | `FAILED`
  mintStatus          String    @default("PENDING") @map("mint_status") @db.VarChar(12)
  quota               Int
  minted              Int       @default(0)
  pendingMintQuantity Int       @default(0) @map("pending_mint_quantity")
  name                String    @db.VarChar(120)
  description         String    @db.Text
  tastingNotes        String?   @map("tasting_notes") @db.Text
  pairing             String?   @db.Text
  estimatedRedeemDate DateTime? @map("estimated_redeem_date") @db.Date
  priceAmountMinor    Int?      @map("price_amount_minor")
  priceCurrency       String?   @map("price_currency") @db.Char(3)
  priceSource         String?   @map("price_source") @db.VarChar(20)
  priceSetAt          DateTime? @map("price_set_at") @db.Timestamptz(6)
  priceSetByUserId    String?   @map("price_set_by_user_id") @db.Uuid
  /// Copia de `precio.politica` al aprobar
  pricePolicySnapshot Json?     @map("price_policy_snapshot") @db.JsonB
  /// `CollectionPrice[]`: solo se añade
  priceHistory        Json      @default("[]") @map("price_history") @db.JsonB
  redeemable          Boolean   @default(false)
  redeemableSince     DateTime? @map("redeemable_since") @db.Timestamptz(6)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery        Winery                    @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  lot           Lot                       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  contract      NftContract               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  requests      TokenizationRequest[]
  images        CollectionImage[]
  statusHistory CollectionStatusHistory[]
  mints         Mint[]
  tokens        Token[]
  closure       LotClosure?

  @@unique([wineryId, slug])
  @@index([wineryId, status])
  @@index([status, publishedAt])
  @@map("collections")
}

/// Imagen de una colección (§5.5): privada hasta publicar; después la sirve la
/// API en `GET /v1/public/collections/images/{id}` (U-5).
model CollectionImage {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  /// `key` de `POST /v1/uploads`
  key          String   @db.VarChar(500)
  sha256       String   @db.Char(64)
  alt          String   @db.VarChar(300)
  isCover      Boolean  @default(false) @map("is_cover")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@unique([collectionId, key])
  @@index([collectionId, position])
  @@map("collection_images")
}

/// Historial de estados de la colección: solo inserción.
model CollectionStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  status       String   @db.VarChar(12)
  reason       String?  @db.Text
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorName    String?  @map("actor_name") @db.VarChar(200)
  actorSystem  Boolean  @default(false) @map("actor_system")
  at           DateTime @default(now()) @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@index([collectionId, at])
  @@map("collection_status_history")
}

/// Emisión (§6.1): una por solicitud aprobada; sus trozos son transacciones
/// `MINT_BATCH` con `intentKey = mint:{id}:{trozo}`.
model Mint {
  id           String    @id @default(uuid()) @db.Uuid
  collectionId String    @map("collection_id") @db.Uuid
  requestId    String    @unique @map("request_id") @db.Uuid
  /// 1 = inicial, 2… = ampliaciones
  sequence     Int
  quantity     Int
  /// `PENDING` | `IN_PROGRESS` | `CONFIRMED` | `FAILED`
  status       String    @default("PENDING") @db.VarChar(12)
  /// Lo enviado como `lot` a `mint_batch` (la referencia del lote, S-12)
  lotArg       String    @map("lot_arg") @db.VarChar(64)
  /// `[{ firstTokenId, lastTokenId, firstBottleNumber, lastBottleNumber }]`
  ranges       Json      @default("[]") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)

  collection Collection          @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  request    TokenizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tokens     Token[]

  @@unique([collectionId, sequence])
  @@map("mints")
}

/// NFT de una botella (§6.3). El estado de negocio vive aquí; la red solo dice
/// de quién es y si está quemado (`onchain*`).
model Token {
  id                 String    @id @default(uuid()) @db.Uuid
  collectionId       String    @map("collection_id") @db.Uuid
  wineryId           String    @map("winery_id") @db.Uuid
  lotId              String    @map("lot_id") @db.Uuid
  contractId         String    @map("contract_id") @db.Uuid
  /// Id en la red (u32, continuo entre lotes del mismo contrato, DS-08)
  tokenId            Int       @map("token_id")
  /// 1…quota dentro de la colección (S-13)
  bottleNumber       Int       @map("bottle_number")
  /// `MINTED` | `RESERVED` | `SOLD` | `REDEEMABLE` | `PASS_ACTIVE` | `REDEEMED` | `BURNED` | `EXPIRED`
  status             String    @default("MINTED") @db.VarChar(12)
  /// `WINERY` | `CONSUMER`
  ownerKind          String    @default("WINERY") @map("owner_kind") @db.VarChar(10)
  ownerAddress       String    @map("owner_address") @db.VarChar(56)
  mintId             String    @map("mint_id") @db.Uuid
  /// `chain_transactions.id` del trozo que lo emitió
  mintTxId           String?   @map("mint_tx_id") @db.Uuid
  soldAt             DateTime? @map("sold_at") @db.Timestamptz(6)
  redeemableAt       DateTime? @map("redeemable_at") @db.Timestamptz(6)
  redeemWindowEndsAt DateTime? @map("redeem_window_ends_at") @db.Timestamptz(6)
  burnedAt           DateTime? @map("burned_at") @db.Timestamptz(6)
  burnTxId           String?   @map("burn_tx_id") @db.Uuid
  /// `REDEMPTION` | `SHORTFALL` | `WINDOW_EXPIRED`
  burnReason         String?   @map("burn_reason") @db.VarChar(16)
  onchainOwner       String?   @map("onchain_owner") @db.VarChar(56)
  onchainBurned      Boolean   @default(false) @map("onchain_burned")
  onchainCheckedAt   DateTime? @map("onchain_checked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection   Collection       @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  contract     NftContract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  mint         Mint             @relation(fields: [mintId], references: [id], onDelete: Restrict)
  closureItems LotClosureItem[]

  @@unique([contractId, tokenId])
  @@unique([collectionId, bottleNumber])
  @@index([collectionId, status])
  @@index([ownerAddress])
  @@map("tokens")
}

/// Cierre del lote con faltante (§8.4): uno por colección.
model LotClosure {
  id                String    @id @default(uuid()) @db.Uuid
  lotId             String    @unique @map("lot_id") @db.Uuid
  collectionId      String    @unique @map("collection_id") @db.Uuid
  /// `NO_SHORTFALL` | `SHORTFALL_OPEN` | `DECIDED` | `RESOLVED`
  status            String    @db.VarChar(16)
  computedAt        DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)
  bottles           Int
  minted            Int
  sold              Int       @default(0)
  reserved          Int       @default(0)
  unsold            Int       @default(0)
  shortfall         Int       @default(0)
  unsoldToBurn      Int       @default(0) @map("unsold_to_burn")
  soldWithoutBottle Int       @default(0) @map("sold_without_bottle")
  /// `KEEP_ON_SALE` | `BURN`
  unsoldPolicy      String?   @map("unsold_policy") @db.VarChar(12)
  decisionByUserId  String?   @map("decision_by_user_id") @db.Uuid
  decisionByName    String?   @map("decision_by_name") @db.VarChar(200)
  decisionAt        DateTime? @map("decision_at") @db.Timestamptz(6)
  decisionReason    String?   @map("decision_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lot        Lot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  collection Collection       @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  items      LotClosureItem[]

  @@index([status, computedAt])
  @@map("lot_closures")
}

/// NFT afectado por un cierre con faltante.
model LotClosureItem {
  id           String    @id @default(uuid()) @db.Uuid
  closureId    String    @map("closure_id") @db.Uuid
  tokenRowId   String    @map("token_row_id") @db.Uuid
  tokenId      Int       @map("token_id")
  bottleNumber Int       @map("bottle_number")
  tokenStatus  String    @map("token_status") @db.VarChar(12)
  /// Ola 4
  orderId      String?   @map("order_id") @db.Uuid
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  /// `BURN_UNSOLD` | `MANUAL_REFUND` | `MANUAL_SUBSTITUTE` | `PENDING`
  outcome      String    @default("PENDING") @db.VarChar(20)
  burnTxId     String?   @map("burn_tx_id") @db.Uuid
  note         String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)

  closure LotClosure @relation(fields: [closureId], references: [id], onDelete: Restrict)
  token   Token      @relation(fields: [tokenRowId], references: [id], onDelete: Restrict)

  @@unique([closureId, tokenId])
  @@map("lot_closure_items")
}

/// Anclaje del expediente (§7): uno por expediente (la clave del expediente es
/// su lote).
model DossierAnchor {
  id            String    @id @default(uuid()) @db.Uuid
  lotId         String    @unique @map("lot_id") @db.Uuid
  /// `PENDING` | `SUBMITTED` | `ANCHORED` | `FAILED`
  status        String    @default("PENDING") @db.VarChar(10)
  network       String    @db.VarChar(10)
  /// Cuenta de anclaje
  account       String    @db.VarChar(56)
  /// SHA-256 del expediente (= `lot_dossiers.hash`)
  memoHashHex   String    @map("memo_hash_hex") @db.Char(64)
  txHash        String?   @map("tx_hash") @db.Char(64)
  ledger        Int?
  anchoredAt    DateTime? @map("anchored_at") @db.Timestamptz(6)
  /// El servidor leyó la transacción y comprobó memo y origen
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  transactionId String?   @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dossier     LotDossier        @relation(fields: [lotId], references: [lotId], onDelete: Restrict)
  transaction ChainTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("dossier_anchors")
}

/// Dirección custodial de un consumidor (§4, preparación de la Ola 4): solo la
/// dirección y el índice; ninguna clave. El índice 0 queda reservado (S-9).
model ConsumerAddress {
  userId         String   @id @map("user_id") @db.Uuid
  /// Creciente y nunca reutilizado
  index          Int      @unique @default(autoincrement())
  address        String   @unique @db.VarChar(56)
  /// `m/44'/148'/{index}'` (SEP-0005)
  derivationPath String   @map("derivation_path") @db.VarChar(40)
  network        String   @db.VarChar(10)
  /// `ACTIVE` | `MIGRATED`
  status         String   @default("ACTIVE") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("consumer_addresses")
}
