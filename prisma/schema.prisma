// -----------------------------------------------------------------------------
// ENTIDADES DE IDENTIDAD Y ACCESO (FASE 3)
// -----------------------------------------------------------------------------
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  phoneNumber         String?   @unique @map("phone_number") @db.VarChar(20)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(200)
  dynamicUserId       String?   @unique @map("dynamic_user_id") @db.VarChar(200)
  preferredLocale     String    @default("es") @map("preferred_locale") @db.Char(2)
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Última organización activa elegida (la de por defecto al iniciar sesión).
  lastOrganizationId  String?   @map("last_organization_id") @db.Uuid
  /// Correo comprobado (enlace de verificación, invitación o recuperación).
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Preferencias de comunicación (IAM-09): `{ lotProgress, redemptionReminders }`.
  notificationPrefs   Json      @default("{\"lotProgress\": true, \"redemptionReminders\": true}") @map("notification_prefs") @db.JsonB
  /// Consentimiento de promociones con su fecha (null = no aceptado).
  promotionsConsentAt DateTime? @map("promotions_consent_at") @db.Timestamptz(6)
  /// Bloqueo de la cuenta completa por la plataforma (`is_active = false`).
  blockedReason       String?   @map("blocked_reason") @db.VarChar(500)
  blockedAt           DateTime? @map("blocked_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relaciones
  lastOrganization         Organization?       @relation("UserLastOrganization", fields: [lastOrganizationId], references: [id], onDelete: SetNull)
  memberships              Membership[]
  sessions                 Session[]
  /// Perfil del miembro en cada bodega (matrícula, autoría); la autorización usa `memberships`.
  wineryMemberships        WineryMember[]
  wallets                  UserWallet[]
  approvedWineries         Winery[]            @relation("ApprovedByUser")
  recordedFermentationLogs FermentationLog[]
  accountTokens            AccountToken[]
  mfa                      UserMfa?
  mfaRecoveryCodes         MfaRecoveryCode[]
  mfaChallenges            MfaChallenge[]
  invitationsSent          Invitation[]        @relation("InvitationInvitedBy")
  assignedApplications     WineryApplication[] @relation("WineryApplicationAssignee")

  @@map("users")
}

model Winery {
  id                    String             @id @default(uuid()) @db.Uuid
  legalName             String             @map("legal_name") @db.VarChar(300)
  commercialName        String             @map("commercial_name") @db.VarChar(300)
  beverageCategory      WineryCategoryEnum @map("beverage_category")
  taxIdNit              String             @unique @map("tax_id_nit") @db.VarChar(20)
  senasagSanitaryReg    String?            @unique @map("senasag_sanitary_reg") @db.VarChar(50)
  geographicRegion      String             @map("geographic_region") @db.VarChar(100)
  countryCode           String             @default("BO") @map("country_code") @db.Char(2)
  address               String?            @db.Text
  contactEmail          String             @map("contact_email") @db.VarChar(255)
  contactPhone          String?            @map("contact_phone") @db.VarChar(20)
  logoUrl               String?            @map("logo_url") @db.VarChar(500)
  stellarPublicKey      String?            @unique @map("stellar_public_key") @db.VarChar(60)
  dynamicVaultId        String?            @unique @map("dynamic_vault_id") @db.VarChar(200)
  onchainProducerId     String?            @unique @map("onchain_producer_id") @db.VarChar(100)
  onchainRegisterTxHash String?            @map("onchain_register_tx_hash") @db.VarChar(100)
  isExportCertified     Boolean            @default(false) @map("is_export_certified")
  certificationStatus   WineryStatusEnum   @default(INVITED) @map("certification_status")
  approvedAt            DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedByUserId      String?            @map("approved_by_user_id") @db.Uuid
  /// Ruta pública (`/v1/public/wineries/{slug}`): única y estable (no cambia al renombrar).
  slug                  String?            @unique @db.VarChar(120)
  /// Prefijo del código de lote (ORG-05): 3–5 letras, único y definitivo; se asigna al activarse.
  lotPrefix             String?            @unique @map("lot_prefix") @db.VarChar(5)
  /// Primera activación (el dueño aceptó su invitación).
  activatedAt           DateTime?          @map("activated_at") @db.Timestamptz(6)
  publicStory           String?            @map("public_story") @db.Text
  website               String?            @db.VarChar(500)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relaciones
  approvedByUser    User?                @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  /// Solicitud de alta aprobada que la creó (camino A).
  application       WineryApplication?
  statusChanges     WineryStatusChange[]
  /// Organización de la bodega (enlace 1:1, mismo id).
  organization      Organization?
  members           WineryMember[]
  wallets           UserWallet[]
  terroirs          Terroir[]
  harvestBatches    HarvestBatch[]
  fermentationTanks FermentationTank[]
  wineAgingBatches  WineAgingBatch[]
  productionBatches ProductionBatch[]
  bottlingBatches   BottlingBatch[]
  settingOverrides  SettingOverride[]
  lots              Lot[]
  lotSequences      LotSequence[]

  @@map("wineries")
}

/// Organización genérica (contrato O0 §4). La de una bodega comparte el id con
/// `wineries` (enlace 1:1 por `winery_id`); su nombre y estado se escriben en la
/// misma transacción que la bodega. La de plataforma la crea la migración.
model Organization {
  id        String                 @id @default(uuid()) @db.Uuid
  type      OrganizationTypeEnum
  name      String                 @db.VarChar(300)
  status    OrganizationStatusEnum @default(ACTIVE)
  wineryId  String?                @unique @map("winery_id") @db.Uuid
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery          Winery?      @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  memberships     Membership[]
  activeSessions  Session[]
  lastUsedByUsers User[]       @relation("UserLastOrganization")
  invitations     Invitation[]

  @@index([type])
  @@map("organizations")
}

/// Membresía de una persona en una organización con su rol (EQP-01, EQP-09).
/// En las bodegas, el id coincide con el de `winery_members` (autoría de la
/// trazabilidad y matrícula), que se mantiene en paralelo.
model Membership {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  role           MembershipRoleEnum
  status         MembershipStatusEnum     @default(ACTIVE)
  blockedBy      MembershipBlockedByEnum? @map("blocked_by")
  blockedReason  String?                  @map("blocked_reason") @db.VarChar(500)
  blockedAt      DateTime?                @map("blocked_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

/// Sesión (contrato O0 §5): `id` es el claim `sid`. Cada renovación rota el
/// refresco (se guarda solo su hash; `generation` cuenta las rotaciones). La
/// familia de refrescos es la sesión entera: una reutilización la revoca.
model Session {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  activeOrganizationId String?      @map("active_organization_id") @db.Uuid
  audience             AudienceEnum
  refreshTokenHash     String       @map("refresh_token_hash") @db.VarChar(64)
  generation           Int          @default(0)
  rotatedAt            DateTime?    @map("rotated_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt           DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt            DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?      @map("revoked_reason") @db.VarChar(50)
  /// Segundo factor superado en esta sesión (obligatorio para la plataforma, PLT-05).
  mfaVerifiedAt        DateTime?    @map("mfa_verified_at") @db.Timestamptz(6)
  ip                   String?      @db.VarChar(64)
  userAgent            String?      @map("user_agent") @db.VarChar(300)

  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([activeOrganizationId, revokedAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// CUENTA, SEGUNDO FACTOR E INVITACIONES (Ola 1 · 1.1 y 1.2; contrato O1 §1–§2)
// docs/arquitectura/identidad.md. De los tokens solo se guarda el SHA-256.
// Las filas de seguridad de una persona se borran con ella (no son negocio).
// -----------------------------------------------------------------------------
enum AccountTokenPurposeEnum {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("account_token_purpose_enum")
}

/// Enlace de un solo uso enviado por correo (recuperación de contraseña,
/// verificación del correo).
model AccountToken {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  purpose     AccountTokenPurposeEnum
  tokenHash   String                  @unique @map("token_hash") @db.Char(64)
  /// Correo al que se envió (el que queda verificado).
  email       String                  @db.VarChar(255)
  expiresAt   DateTime                @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?               @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  requestedIp String?                 @map("requested_ip") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("account_tokens")
}

/// Segundo factor TOTP de una persona (PLT-05). El secreto va cifrado con
/// AES-256-GCM (`MFA_ENCRYPTION_KEY`). La fila existe también sin inscribir
/// para contar los fallos seguidos y el bloqueo temporal.
model UserMfa {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String?   @map("secret_encrypted") @db.Text
  enrolledAt      DateTime? @map("enrolled_at") @db.Timestamptz(6)
  /// Último paso de 30 s aceptado: un mismo código no vale dos veces.
  lastUsedStep    Int?      @map("last_used_step")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Códigos de recuperación (10 por inscripción, un solo uso; se guarda su HMAC).
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Reto de segundo factor (`mfaToken`): 5 min, un solo uso. Lo emite el login
/// (o aceptar una invitación de plataforma) sin abrir sesión.
model MfaChallenge {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  tokenHash              String    @unique @map("token_hash") @db.Char(64)
  /// Secreto propuesto en `mfa/enroll`, pendiente de confirmar (cifrado).
  pendingSecretEncrypted String?   @map("pending_secret_encrypted") @db.Text
  /// Organización que queda activa al superarlo (invitación aceptada).
  organizationId         String?   @map("organization_id") @db.Uuid
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt                 DateTime? @map("used_at") @db.Timestamptz(6)
  ip                     String?   @db.VarChar(64)
  userAgent              String?   @map("user_agent") @db.VarChar(300)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("mfa_challenges")
}

enum InvitationStatusEnum {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status_enum")
}

/// Invitación a una organización (IAM-10, EQP-03, PLT-02). Una `PENDING` con
/// `expires_at` vencido se presenta como `EXPIRED`.
model Invitation {
  id               String               @id @default(uuid()) @db.Uuid
  email            String               @db.VarChar(255)
  organizationId   String               @map("organization_id") @db.Uuid
  role             MembershipRoleEnum
  status           InvitationStatusEnum @default(PENDING)
  tokenHash        String               @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  invitedByUserId  String?              @map("invited_by_user_id") @db.Uuid
  invitedByName    String               @map("invited_by_name") @db.VarChar(200)
  viaPlatform      Boolean              @default(false) @map("via_platform")
  /// Nombre propuesto (alta de bodega); la persona elige el suyo al aceptar.
  inviteeName      String?              @map("invitee_name") @db.VarChar(200)
  /// `MEMBER`, `OWNER_ONBOARDING` u `OWNERSHIP_TRANSFER` (alta y transferencia, §4).
  purpose          String               @default("MEMBER") @db.VarChar(30)
  /// Datos del proceso que la creó (p. ej. la transferencia de titularidad).
  metadata         Json?                @db.JsonB
  sentCount        Int                  @default(1) @map("sent_count")
  lastSentAt       DateTime             @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt       DateTime?            @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?              @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedByUser User?        @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([status, expiresAt])
  @@map("invitations")
}

// -----------------------------------------------------------------------------
// SOLICITUDES DE ALTA Y ESTADO DE LAS BODEGAS (Ola 1 · 1.3–1.5; contrato O1 §3–§4)
// docs/arquitectura/organizaciones.md. Del token de verificación solo se guarda
// el SHA-256.
// -----------------------------------------------------------------------------
enum WineryApplicationStatusEnum {
  UNVERIFIED
  RECEIVED
  IN_REVIEW
  MEETING_SCHEDULED
  APPROVED
  REJECTED

  @@map("winery_application_status_enum")
}

enum MeetingChannelEnum {
  CALL
  VIDEO
  IN_PERSON

  @@map("meeting_channel_enum")
}

enum WaitlistTypeEnum {
  CONSUMER
  WINERY

  @@map("waitlist_type_enum")
}

enum WaitlistStatusEnum {
  NEW
  CONTACTED
  DISCARDED

  @@map("waitlist_status_enum")
}

enum WaitlistInterestEnum {
  WINE
  SINGANI
  BOTH

  @@map("waitlist_interest_enum")
}

enum WaitlistProducesEnum {
  WINE
  SINGANI
  BOTH
  OTHER

  @@map("waitlist_produces_enum")
}

/// Solicitud de alta de una bodega desde el formulario público (ORG-01, ORG-02).
model WineryApplication {
  id                 String                      @id @default(uuid()) @db.Uuid
  status             WineryApplicationStatusEnum @default(UNVERIFIED)
  legalName          String                      @map("legal_name") @db.VarChar(300)
  tradeName          String                      @map("trade_name") @db.VarChar(300)
  /// NIT (solo dígitos).
  taxId              String                      @map("tax_id") @db.VarChar(20)
  category           WineryCategoryEnum
  region             String                      @db.VarChar(120)
  contactName        String                      @map("contact_name") @db.VarChar(200)
  contactEmail       String                      @map("contact_email") @db.VarChar(255)
  contactPhone       String?                     @map("contact_phone") @db.VarChar(30)
  message            String?                     @db.Text
  /// Enlace de verificación del correo de contacto (hash; se borra al usarlo).
  verifyTokenHash    String?                     @unique @map("verify_token_hash") @db.Char(64)
  verifyExpiresAt    DateTime?                   @map("verify_expires_at") @db.Timestamptz(6)
  verifiedAt         DateTime?                   @map("verified_at") @db.Timestamptz(6)
  /// IP real del envío (límite por IP).
  submittedIp        String?                     @map("submitted_ip") @db.VarChar(64)
  assigneeUserId     String?                     @map("assignee_user_id") @db.Uuid
  assigneeName       String?                     @map("assignee_name") @db.VarChar(200)
  meetingScheduledAt DateTime?                   @map("meeting_scheduled_at") @db.Timestamptz(6)
  meetingChannel     MeetingChannelEnum?         @map("meeting_channel")
  meetingNotes       String?                     @map("meeting_notes") @db.Text
  decisionByUserId   String?                     @map("decision_by_user_id") @db.Uuid
  decisionByName     String?                     @map("decision_by_name") @db.VarChar(200)
  decidedAt          DateTime?                   @map("decided_at") @db.Timestamptz(6)
  decisionReason     String?                     @map("decision_reason") @db.Text
  /// Bodega creada al aprobarla.
  wineryId           String?                     @unique @map("winery_id") @db.Uuid
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignee User?                   @relation("WineryApplicationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  winery   Winery?                 @relation(fields: [wineryId], references: [id], onDelete: SetNull)
  notes    WineryApplicationNote[]

  @@index([status, createdAt])
  @@index([taxId])
  @@index([contactEmail, createdAt])
  @@index([submittedIp, createdAt])
  @@index([assigneeUserId])
  @@map("winery_applications")
}

/// Nota interna de operaciones sobre una solicitud (también la de la reunión hecha).
model WineryApplicationNote {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  text          String   @db.Text
  authorUserId  String?  @map("author_user_id") @db.Uuid
  authorName    String   @map("author_name") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application WineryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("winery_application_notes")
}

/// Inscripción en la lista de espera (contrato O1b): consumidores (landing) y
/// bodegas (sitio de bodegas). Única por tipo y correo normalizado.
model WaitlistEntry {
  id                String                @id @default(uuid()) @db.Uuid
  type              WaitlistTypeEnum
  /// Número de orden dentro de su tipo (desde 1, sin huecos; ver `WaitlistCounter`).
  position          Int
  status            WaitlistStatusEnum    @default(NEW)
  /// Persona (consumidor) o persona de contacto (bodega).
  fullName          String                @map("full_name") @db.VarChar(120)
  /// Normalizado: minúsculas y sin espacios.
  email             String                @db.VarChar(255)
  phone             String?               @db.VarChar(20)
  city              String?               @db.VarChar(80)
  interest          WaitlistInterestEnum?
  wineryName        String?               @map("winery_name") @db.VarChar(160)
  region            String?               @db.VarChar(80)
  produces          WaitlistProducesEnum?
  message           String?               @db.VarChar(500)
  /// Declaración de mayoría de edad (consumidores, Ley 259).
  isAdult           Boolean?              @map("is_adult")
  locale            String                @default("es") @db.VarChar(2)
  /// Origen de la inscripción (`tarija-2026`).
  source            String?               @db.VarChar(40)
  consentAt         DateTime              @map("consent_at") @db.Timestamptz(6)
  /// IP real del envío (abuso; no se exporta).
  ip                String?               @db.VarChar(64)
  userAgent         String?               @map("user_agent") @db.VarChar(300)
  contactedAt       DateTime?             @map("contacted_at") @db.Timestamptz(6)
  contactedByUserId String?               @map("contacted_by_user_id") @db.Uuid
  contactedByName   String?               @map("contacted_by_name") @db.VarChar(200)
  notes             String?               @db.VarChar(1000)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, email])
  @@unique([type, position])
  @@index([type, createdAt])
  @@index([type, status])
  @@index([source])
  @@index([createdAt])
  @@map("waitlist_entries")
}

/// Último número de orden entregado por tipo. La fila se bloquea al inscribir:
/// posiciones consecutivas y sin carreras.
model WaitlistCounter {
  type         WaitlistTypeEnum @id
  lastPosition Int              @default(0) @map("last_position")

  @@map("waitlist_counters")
}

/// Historial de estados de una bodega (`statusHistory` de la ficha, contrato O1 §4).
model WineryStatusChange {
  id        String           @id @default(uuid()) @db.Uuid
  wineryId  String           @map("winery_id") @db.Uuid
  status    WineryStatusEnum
  changedAt DateTime         @default(now()) @map("changed_at") @db.Timestamptz(6)
  byUserId  String?          @map("by_user_id") @db.Uuid
  /// Nombre de quien hizo el cambio (el dueño al activarse; "Sistema" en los anteriores a la Ola 1).
  byName    String           @map("by_name") @db.VarChar(200)
  reason    String?          @db.Text

  winery Winery @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  @@index([wineryId, changedAt])
  @@map("winery_status_changes")
}

/// Perfil del miembro en la bodega (matrícula) y autoría de la trazabilidad
/// (claves foráneas de vendimia, tratamientos, embotellado y laboratorio). No
/// autoriza nada: la autorización usa `memberships` (mismo id); `member_role` e
/// `is_active` se mantienen sincronizados con ella. Se conservó en la retirada
/// de H1 por esas claves foráneas.
model WineryMember {
  id                        String               @id @default(uuid()) @db.Uuid
  userId                    String               @map("user_id") @db.Uuid
  wineryId                  String               @map("winery_id") @db.Uuid
  memberRole                WineryMemberRoleEnum @map("member_role")
  professionalLicenseNumber String?              @map("professional_license_number") @db.VarChar(100)
  professionalLicensePdfUrl String?              @map("professional_license_pdf_url") @db.VarChar(500)
  isActive                  Boolean              @default(true) @map("is_active")
  joinedAt                  DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)

  // Relaciones
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  winery                  Winery                @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  certifiedHarvestBatches HarvestBatch[]
  authorizedTreatments    EnologicalTreatment[]
  releasedBottlingBatches BottlingBatch[]
  reviewedLabAnalyses     BatchLabAnalysis[]

  @@unique([userId, wineryId])
  @@map("winery_members")
}

model UserWallet {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  wineryId             String?           @map("winery_id") @db.Uuid
  stellarPublicAddress String            @unique @map("stellar_public_address") @db.VarChar(60)
  dynamicVaultId       String            @unique @map("dynamic_vault_id") @db.VarChar(200)
  walletType           WalletTypeEnum    @default(CUSTODIAL) @map("wallet_type")
  walletPurpose        WalletPurposeEnum @map("wallet_purpose")
  isPrimary            Boolean           @default(true) @map("is_primary")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relaciones
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  winery Winery? @relation(fields: [wineryId], references: [id], onDelete: SetNull)

  @@map("user_wallets")
}

// -----------------------------------------------------------------------------
// ENTIDADES DE TRAZABILIDAD ERP (FASE 4)
// -----------------------------------------------------------------------------
model Terroir {
  id                       String   @id @default(uuid()) @db.Uuid
  wineryId                 String   @map("winery_id") @db.Uuid
  parcelName               String   @map("parcel_name") @db.VarChar(200)
  cadastreCode             String?  @map("cadastre_code") @db.VarChar(50)
  surfaceHectares          Decimal  @map("surface_hectares") @db.Decimal(10, 4)
  altitudeMasl             Decimal  @map("altitude_masl") @db.Decimal(8, 2)
  latitude                 Decimal? @map("latitude") @db.Decimal(10, 8)
  longitude                Decimal? @map("longitude") @db.Decimal(11, 8)
  geographicPolygonGeojson Json?    @map("geographic_polygon_geojson")
  rawMaterialType          String   @map("raw_material_type") @db.VarChar(100)
  varietyName              String   @map("variety_name") @db.VarChar(200)
  soilType                 String?  @map("soil_type") @db.VarChar(100)
  irrigationSystem         String?  @map("irrigation_system") @db.VarChar(100)
  isDoEligible             Boolean  @default(false) @map("is_do_eligible")
  doType                   String?  @map("do_type") @db.VarChar(100)
  doCertificateUrl         String?  @map("do_certificate_url") @db.VarChar(500)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relaciones
  winery         Winery         @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  harvestBatches HarvestBatch[]

  @@map("terroirs")
}

model HarvestBatch {
  id                    String          @id @default(uuid()) @db.Uuid
  wineryId              String          @map("winery_id") @db.Uuid
  terroirId             String          @map("terroir_id") @db.Uuid
  harvestBatchCode      String          @map("harvest_batch_code") @db.VarChar(50)
  intakeDate            DateTime        @map("intake_date") @db.Date
  harvestYear           Int             @map("harvest_year") @db.SmallInt
  grossWeightKg         Decimal         @map("gross_weight_kg") @db.Decimal(12, 3)
  tareWeightKg          Decimal         @map("tare_weight_kg") @db.Decimal(12, 3)
  netWeightKg           Decimal         @map("net_weight_kg") @db.Decimal(12, 3)
  /// Último análisis de madurez (Ola 2: nulos sin análisis; el historial está en `maturity_analyses`)
  brixDegrees           Decimal?        @map("brix_degrees") @db.Decimal(5, 2)
  initialPh             Decimal?        @map("initial_ph") @db.Decimal(4, 2)
  initialAcidityGl      Decimal?        @map("initial_acidity_gl") @db.Decimal(6, 3)
  temperatureAtIntakeC  Decimal?        @map("temperature_at_intake_c") @db.Decimal(5, 2)
  phytosanitaryStatus   PhytoStatusEnum @default(PENDING_INSPECTION) @map("phytosanitary_status")
  phytoInspectionPdfUrl String?         @map("phyto_inspection_pdf_url") @db.VarChar(500)
  certifiedByMemberId   String?         @map("certified_by_member_id") @db.Uuid
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Lote (Ola 2). Nulo = uva recibida sin lote.
  lotId                 String?         @map("lot_id") @db.Uuid
  /// La parcela tal como era al pesar: `{ parcelName, altitudeMasl, varietyName, rawMaterialType, takenAt }`
  terroirSnapshot       Json?           @map("terroir_snapshot") @db.JsonB
  createdByMembershipId String?         @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery            Winery                  @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  terroir           Terroir                 @relation(fields: [terroirId], references: [id], onDelete: Cascade)
  certifiedByMember WineryMember?           @relation(fields: [certifiedByMemberId], references: [id], onDelete: SetNull)
  lot               Lot?                    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  fermentationTanks FermentationTank[]
  tankInputs        FermentationTankInput[]
  phytoDecisions    PhytoDecision[]
  maturityAnalyses  MaturityAnalysis[]

  @@unique([wineryId, harvestBatchCode])
  @@index([lotId])
  @@map("harvest_batches")
}

model FermentationTank {
  id                    String               @id @default(uuid()) @db.Uuid
  wineryId              String               @map("winery_id") @db.Uuid
  harvestBatchId        String               @map("harvest_batch_id") @db.Uuid
  tankCode              String               @map("tank_code") @db.VarChar(50)
  capacityLiters        Decimal?             @map("capacity_liters") @db.Decimal(12, 2)
  material              String?              @db.VarChar(50)
  volumeFilledLiters    Decimal?             @map("volume_filled_liters") @db.Decimal(12, 2)
  destinationType       DestinationTypeEnum? @map("destination_type")
  status                TankStatusEnum       @default(FILLING)
  startDate             DateTime             @map("start_date") @db.Timestamptz(6)
  endDate               DateTime?            @map("end_date") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                 String?              @map("lot_id") @db.Uuid
  finalVolumeLiters     Decimal?             @map("final_volume_liters") @db.Decimal(12, 2)
  createdByMembershipId String?              @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery            Winery                  @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  harvestBatch      HarvestBatch            @relation(fields: [harvestBatchId], references: [id], onDelete: Cascade)
  lot               Lot?                    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  inputs            FermentationTankInput[]
  logs              FermentationLog[]
  treatments        EnologicalTreatment[]
  wineAgingBatch    WineAgingBatch?
  productionBatches ProductionBatch[]

  @@index([lotId])
  @@map("fermentation_tanks")
}

model FermentationLog {
  id                 String   @id @default(uuid()) @db.Uuid
  fermentationTankId String   @map("fermentation_tank_id") @db.Uuid
  temperatureCelsius Decimal  @map("temperature_celsius") @db.Decimal(5, 2)
  specificGravity    Decimal? @map("specific_gravity") @db.Decimal(6, 4)
  phValue            Decimal? @map("ph_value") @db.Decimal(4, 2)
  co2Observations    String?  @map("co2_observations") @db.VarChar(100)
  recordedAt         DateTime @map("recorded_at") @db.Timestamptz(6)
  recordedByUserId   String   @map("recorded_by_user_id") @db.Uuid
  notes              String?  @db.Text

  // Relaciones
  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Cascade)
  recordedByUser   User             @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([fermentationTankId])
  @@index([recordedAt])
  @@map("fermentation_logs")
}

model EnologicalTreatment {
  id                   String            @id @default(uuid()) @db.Uuid
  fermentationTankId   String            @map("fermentation_tank_id") @db.Uuid
  treatmentType        TreatmentTypeEnum @map("treatment_type")
  additiveName         String            @map("additive_name") @db.VarChar(200)
  additiveSupplier     String?           @map("additive_supplier") @db.VarChar(200)
  dosageAppliedGPerHl  Decimal           @map("dosage_applied_g_per_hl") @db.Decimal(10, 4)
  totalAppliedG        Decimal?          @map("total_applied_g") @db.Decimal(12, 4)
  regulatoryAuthCode   String            @map("regulatory_auth_code") @db.VarChar(100)
  appliedAt            DateTime          @map("applied_at") @db.Timestamptz(6)
  authorizedByMemberId String            @map("authorized_by_member_id") @db.Uuid
  notes                String?           @db.Text

  // Relaciones
  fermentationTank   FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Cascade)
  authorizedByMember WineryMember     @relation(fields: [authorizedByMemberId], references: [id], onDelete: Restrict)

  @@map("enological_treatments")
}

model WineAgingBatch {
  id                    String          @id @default(uuid()) @db.Uuid
  wineryId              String          @map("winery_id") @db.Uuid
  fermentationTankId    String          @unique @map("fermentation_tank_id") @db.Uuid
  containerType         String          @map("container_type") @db.VarChar(100)
  containerMaterial     String?         @map("container_material") @db.VarChar(100)
  containerCode         String?         @map("container_code") @db.VarChar(100)
  barrelUseCycle        Int?            @map("barrel_use_cycle")
  volumeLiters          Decimal?        @map("volume_liters") @db.Decimal(12, 2)
  plannedMonths         Int             @map("planned_months")
  lockUntilDate         DateTime        @map("lock_until_date") @db.Date
  agingStatus           AgingStatusEnum @default(AGING) @map("aging_status")
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                 String?         @map("lot_id") @db.Uuid
  /// Inicio de la crianza (el candado se cuenta desde aquí)
  startDate             DateTime?       @map("start_date") @db.Date
  containerCount        Int?            @map("container_count")
  discardedAt           DateTime?       @map("discarded_at") @db.Timestamptz(6)
  discardReason         String?         @map("discard_reason") @db.Text
  createdByMembershipId String?         @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery           Winery           @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Cascade)
  lot              Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bottlingBatches  BottlingBatch[]

  @@index([lotId])
  @@map("wine_aging_batches")
}

model ProductionBatch {
  id                       String                @id @default(uuid()) @db.Uuid
  wineryId                 String                @map("winery_id") @db.Uuid
  fermentationTankId       String                @map("fermentation_tank_id") @db.Uuid
  processType              ProductionProcessEnum @map("process_type")
  equipmentIdentifier      String                @map("equipment_identifier") @db.VarChar(100)
  processStartDate         DateTime              @map("process_start_date") @db.Date
  processEndDate           DateTime?             @map("process_end_date") @db.Date
  inputVolumeLiters        Decimal?              @map("input_volume_liters") @db.Decimal(10, 3)
  outputVolumeLiters       Decimal?              @map("output_volume_liters") @db.Decimal(10, 3)
  wasteVolumeLiters        Decimal?              @map("waste_volume_liters") @db.Decimal(10, 3)
  initialAlcoholPercentage Decimal?              @map("initial_alcohol_percentage") @db.Decimal(5, 2)
  isDoEligible             Boolean               @default(false) @map("is_do_eligible")
  mandatoryRestUntil       DateTime?             @map("mandatory_rest_until") @db.Date
  restStatus               RestStatusEnum        @default(NOT_REQUIRED) @map("rest_status")
  additionalParams         Json?                 @map("additional_params")
  notes                    String?               @db.Text
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                    String?               @map("lot_id") @db.Uuid
  /// Cortes del cierre (Ola 2); los legados quedan en `additionalParams`
  headsLiters              Decimal?              @map("heads_liters") @db.Decimal(10, 3)
  heartLiters              Decimal?              @map("heart_liters") @db.Decimal(10, 3)
  tailsLiters              Decimal?              @map("tails_liters") @db.Decimal(10, 3)
  vinasseLiters            Decimal?              @map("vinasse_liters") @db.Decimal(10, 3)
  heartAbvPercent          Decimal?              @map("heart_abv_percent") @db.Decimal(5, 2)
  discardedAt              DateTime?             @map("discarded_at") @db.Timestamptz(6)
  discardReason            String?               @map("discard_reason") @db.Text
  createdByMembershipId    String?               @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery           Winery           @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Cascade)
  lot              Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bottlingBatches  BottlingBatch[]

  @@index([lotId])
  @@map("production_batches")
}

model BottlingBatch {
  id                     String           @id @default(uuid()) @db.Uuid
  wineryId               String           @map("winery_id") @db.Uuid
  wineAgingBatchId       String?          @map("wine_aging_batch_id") @db.Uuid
  productionBatchId      String?          @map("production_batch_id") @db.Uuid
  productType            BeverageTypeEnum @map("product_type")
  internationalLotCode   String           @unique @map("international_lot_code") @db.VarChar(100)
  finalAlcoholAbv        Decimal          @map("final_alcohol_abv") @db.Decimal(5, 2)
  waterDilutionLiters    Decimal?         @map("water_dilution_liters") @db.Decimal(10, 3)
  totalBottlesPackaged   Int              @map("total_bottles_packaged")
  packagingFormatCl      Int              @map("packaging_format_cl")
  bottleType             String?          @map("bottle_type") @db.VarChar(100)
  labelDesignUrl         String?          @map("label_design_url") @db.VarChar(500)
  bottlingDate           DateTime         @map("bottling_date") @db.Date
  releasedByMemberId     String?          @map("released_by_member_id") @db.Uuid
  blockchainAnchorTxHash String?          @map("blockchain_anchor_tx_hash") @db.VarChar(100)
  blockchainDataHash     String?          @map("blockchain_data_hash") @db.Char(64)
  isAnchoredOnChain      Boolean          @default(false) @map("is_anchored_on_chain")
  anchoredAt             DateTime?        @map("anchored_at") @db.Timestamptz(6)
  qrBatchUrl             String?          @map("qr_batch_url") @db.VarChar(500)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Un embotellado por lote (S-10): restricción única
  lotId                  String?          @unique @map("lot_id") @db.Uuid
  availableLiters        Decimal?         @map("available_liters") @db.Decimal(12, 3)
  leftoverLiters         Decimal?         @map("leftover_liters") @db.Decimal(12, 3)
  leftoverDisposition    String?          @map("leftover_disposition") @db.VarChar(20)
  leftoverNotes          String?          @map("leftover_notes") @db.Text
  labelDesignKey         String?          @map("label_design_key") @db.VarChar(500)
  createdByMembershipId  String?          @map("created_by_membership_id") @db.Uuid

  // Relaciones
  winery           Winery             @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  wineAgingBatch   WineAgingBatch?    @relation(fields: [wineAgingBatchId], references: [id], onDelete: SetNull)
  productionBatch  ProductionBatch?   @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)
  releasedByMember WineryMember?      @relation(fields: [releasedByMemberId], references: [id], onDelete: SetNull)
  lot              Lot?               @relation(fields: [lotId], references: [id], onDelete: Restrict)
  /// Todos los análisis (reanálisis); el vigente es el último sin `supersededAt`
  labAnalyses      BatchLabAnalysis[]
  bottleUnits      BottleUnit[]

  @@map("bottling_batches")
}

model BatchLabAnalysis {
  id                             String    @id @default(uuid()) @db.Uuid
  bottlingBatchId                String    @map("bottling_batch_id") @db.Uuid
  certifiedLaboratoryName        String    @map("certified_laboratory_name") @db.VarChar(300)
  accreditedLabCertificationCode String    @map("accredited_lab_certification_code") @db.VarChar(100)
  analysisRequestDate            DateTime? @map("analysis_request_date") @db.Date
  testPerformedAt                DateTime  @map("test_performed_at") @db.Date
  actualAlcoholAbv               Decimal   @map("actual_alcohol_abv") @db.Decimal(5, 2)
  totalAlcoholAbv                Decimal?  @map("total_alcohol_abv") @db.Decimal(5, 2)
  totalAcidityTartaricGl         Decimal   @map("total_acidity_tartaric_gl") @db.Decimal(6, 3)
  volatileAcidityAceticGl        Decimal   @map("volatile_acidity_acetic_gl") @db.Decimal(6, 3)
  freeSulfurDioxideMgL           Decimal?  @map("free_sulfur_dioxide_mg_l") @db.Decimal(7, 3)
  totalSulfurDioxideMgL          Decimal?  @map("total_sulfur_dioxide_mg_l") @db.Decimal(7, 3)
  reducingSugarsGl               Decimal?  @map("reducing_sugars_gl") @db.Decimal(7, 3)
  totalDryExtractGl              Decimal?  @map("total_dry_extract_gl") @db.Decimal(7, 3)
  sugarFreeDryExtractGl          Decimal?  @map("sugar_free_dry_extract_gl") @db.Decimal(7, 3)
  overpressureBar                Decimal?  @map("overpressure_bar") @db.Decimal(5, 2)
  methanolContentMgL             Decimal?  @map("methanol_content_mg_l") @db.Decimal(7, 3)
  copperContentMgL               Decimal?  @map("copper_content_mg_l") @db.Decimal(7, 3)
  additionalParams               Json?     @map("additional_params")
  laboratoryReportPdfUrl         String    @map("laboratory_report_pdf_url") @db.VarChar(500)
  conformsToSenasagStandards     Boolean   @default(false) @map("conforms_to_senasag_standards")
  conformsToEuStandards          Boolean   @default(false) @map("conforms_to_eu_standards")
  conformsToUsaStandards         Boolean   @default(false) @map("conforms_to_usa_standards")
  reviewedByMemberId             String?   @map("reviewed_by_member_id") @db.Uuid
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lotId                          String?   @map("lot_id") @db.Uuid
  /// Metanol en mg/100 mL de alcohol anhidro (calculado si solo llega mg/L)
  methanolMg100mlAa              Decimal?  @map("methanol_mg_100ml_aa") @db.Decimal(9, 3)
  /// Conformidad calculada contra la instantánea del lote (`LabConformity`)
  conformity                     Json?     @db.JsonB
  conformityStatus               String?   @map("conformity_status") @db.VarChar(20)
  /// Sustituido por un análisis posterior (reanálisis)
  supersededAt                   DateTime? @map("superseded_at") @db.Timestamptz(6)
  laboratoryReportKey            String?   @map("laboratory_report_key") @db.VarChar(500)
  createdByMembershipId          String?   @map("created_by_membership_id") @db.Uuid

  // Relaciones
  bottlingBatch    BottlingBatch @relation(fields: [bottlingBatchId], references: [id], onDelete: Cascade)
  reviewedByMember WineryMember? @relation(fields: [reviewedByMemberId], references: [id], onDelete: SetNull)
  lot              Lot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([bottlingBatchId, createdAt])
  @@index([lotId])
  @@map("batch_lab_analyses")
}

// -----------------------------------------------------------------------------
// LOTE Y TRAZABILIDAD CONFIABLE (Ola 2; plan/contratos/o2-erp-confiable.md)
// El lote agrupa la cadena. Solo inserción: los errores se corrigen con
// registros compensatorios (`trace_corrections`). Los actores se guardan por
// su membresía (`*_membership_id`, sin clave foránea, como en la bitácora).
// -----------------------------------------------------------------------------
enum LotStageEnum {
  ORIGIN
  HARVEST
  FERMENTING
  AGING
  DISTILLING
  RESTING
  BOTTLED
  CERTIFIED
  ANCHORED
  REJECTED
  DISCARDED

  @@map("lot_stage_enum")
}

enum LotProductTypeEnum {
  WINE
  SINGANI

  @@map("lot_product_type_enum")
}

enum BottleUnitStatusEnum {
  ACTIVE
  VOIDED

  @@map("bottle_unit_status_enum")
}

model Lot {
  id                      String              @id @default(uuid()) @db.Uuid
  wineryId                String              @map("winery_id") @db.Uuid
  /// Interno, desde la creación: `{lotPrefix}-L{año}-{NNN}`
  reference               String              @unique @db.VarChar(40)
  /// Código de lote de la etiqueta (= `bottling_batches.international_lot_code`)
  lotCode                 String?             @unique @map("lot_code") @db.VarChar(100)
  name                    String              @db.VarChar(120)
  productType             LotProductTypeEnum? @map("product_type")
  stage                   LotStageEnum        @default(ORIGIN)
  stageChangedAt          DateTime            @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  harvestYear             Int                 @map("harvest_year") @db.SmallInt
  estimatedBottles        Int?                @map("estimated_bottles")
  plannedFormatCl         Int?                @map("planned_format_cl")
  targetAbvPercent        Decimal?            @map("target_abv_percent") @db.Decimal(5, 2)
  targetReadyDate         DateTime?           @map("target_ready_date") @db.Date
  plannedTerroirIds       String[]            @default([]) @map("planned_terroir_ids") @db.Uuid
  /// Instantánea de reglas (`LotRules`, CFG-06): no se edita nunca
  rules                   Json                @db.JsonB
  /// `LOT_CREATION` | `MIGRATION`
  rulesOrigin             String              @map("rules_origin") @db.VarChar(20)
  notes                   String?             @db.Text
  discardedAt             DateTime?           @map("discarded_at") @db.Timestamptz(6)
  discardedByMembershipId String?             @map("discarded_by_membership_id") @db.Uuid
  discardReason           String?             @map("discard_reason") @db.Text
  createdByMembershipId   String?             @map("created_by_membership_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery            Winery               @relation(fields: [wineryId], references: [id], onDelete: Restrict)
  harvestBatches    HarvestBatch[]
  fermentationTanks FermentationTank[]
  wineAgingBatches  WineAgingBatch[]
  productionBatches ProductionBatch[]
  bottlingBatch     BottlingBatch?
  labAnalyses       BatchLabAnalysis[]
  events            LotEvent[]
  bottleUnits       BottleUnit[]
  bottleCodeExports BottleCodeExport[]
  corrections       TraceCorrection[]
  complianceIssues  LotComplianceIssue[]
  attachments       LotAttachment[]
  dossier           LotDossier?

  @@index([wineryId, stage])
  @@index([wineryId, updatedAt])
  @@map("lots")
}

/// Línea de tiempo del lote (§11.1): un evento por escritura, en la misma transacción.
model LotEvent {
  id                String       @id @default(uuid()) @db.Uuid
  lotId             String       @map("lot_id") @db.Uuid
  seq               Int
  type              String       @db.VarChar(40)
  occurredAt        DateTime     @map("occurred_at") @db.Timestamptz(6)
  recordedAt        DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  stage             LotStageEnum
  actorMembershipId String?      @map("actor_membership_id") @db.Uuid
  summary           String       @db.Text
  data              Json         @default("{}") @db.JsonB
  resourceType      String       @map("resource_type") @db.VarChar(40)
  resourceId        String       @map("resource_id") @db.VarChar(100)
  /// `PUBLIC` | `INTERNAL`
  visibility        String       @default("INTERNAL") @db.VarChar(10)
  corrected         Boolean      @default(false)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([lotId, seq])
  @@index([lotId, occurredAt])
  @@map("lot_events")
}

/// Secuencias por bodega, año y ámbito (EA-07): `INSERT … ON CONFLICT DO
/// UPDATE … RETURNING` (bloqueo de fila). Ámbitos: `HARVEST` (código de
/// vendimia), `LOT_CODE` (código de lote de la etiqueta), `LOT_REFERENCE`.
model LotSequence {
  wineryId  String   @map("winery_id") @db.Uuid
  year      Int      @db.SmallInt
  scope     String   @db.VarChar(30)
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  winery Winery @relation(fields: [wineryId], references: [id], onDelete: Restrict)

  @@id([wineryId, year, scope])
  @@map("lot_sequences")
}

/// Dictamen fitosanitario (§3.4, EA-04): solo inserción; el estado del pesaje es el del último.
model PhytoDecision {
  id                     String          @id @default(uuid()) @db.Uuid
  harvestBatchId         String          @map("harvest_batch_id") @db.Uuid
  decision               PhytoStatusEnum
  decidedAt              DateTime        @map("decided_at") @db.Timestamptz(6)
  recordedAt             DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  decidedByMembershipId  String?         @map("decided_by_membership_id") @db.Uuid
  inspectionReportKey    String?         @map("inspection_report_key") @db.VarChar(500)
  inspectionReportSha256 String?         @map("inspection_report_sha256") @db.Char(64)
  notes                  String?         @db.Text
  /// `ERP` | `MIGRATION`
  source                 String          @default("ERP") @db.VarChar(20)
  voidedAt               DateTime?       @map("voided_at") @db.Timestamptz(6)

  harvestBatch HarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@index([harvestBatchId, recordedAt])
  @@map("phyto_decisions")
}

/// Análisis de madurez (§3.3): solo inserción; el último es el vigente.
model MaturityAnalysis {
  id                     String    @id @default(uuid()) @db.Uuid
  harvestBatchId         String    @map("harvest_batch_id") @db.Uuid
  brixDegrees            Decimal   @map("brix_degrees") @db.Decimal(5, 2)
  ph                     Decimal   @db.Decimal(4, 2)
  acidityGl              Decimal   @map("acidity_gl") @db.Decimal(6, 3)
  measuredAt             DateTime  @map("measured_at") @db.Timestamptz(6)
  recordedAt             DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedByMembershipId String?   @map("recorded_by_membership_id") @db.Uuid
  notes                  String?   @db.Text
  /// `ERP` | `MIGRATION`
  source                 String    @default("ERP") @db.VarChar(20)
  voidedAt               DateTime? @map("voided_at") @db.Timestamptz(6)

  harvestBatch HarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@index([harvestBatchId, measuredAt])
  @@map("maturity_analyses")
}

/// Entradas de uva a un tanque (§4.1): kilos de cada pesaje.
model FermentationTankInput {
  id                 String   @id @default(uuid()) @db.Uuid
  fermentationTankId String   @map("fermentation_tank_id") @db.Uuid
  harvestBatchId     String   @map("harvest_batch_id") @db.Uuid
  kg                 Decimal  @db.Decimal(12, 3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fermentationTank FermentationTank @relation(fields: [fermentationTankId], references: [id], onDelete: Restrict)
  harvestBatch     HarvestBatch     @relation(fields: [harvestBatchId], references: [id], onDelete: Restrict)

  @@unique([fermentationTankId, harvestBatchId])
  @@index([harvestBatchId])
  @@map("fermentation_tank_inputs")
}

/// Código de botella (§7, A-26): 8 caracteres Crockford (7 aleatorios + control Luhn mod 32).
model BottleUnit {
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique @db.Char(8)
  serial               Int
  lotId                String               @map("lot_id") @db.Uuid
  bottlingBatchId      String               @map("bottling_batch_id") @db.Uuid
  status               BottleUnitStatusEnum @default(ACTIVE)
  /// Sal aleatoria de la hoja Merkle del expediente (16 bytes en hex)
  salt                 String               @db.Char(32)
  voidedAt             DateTime?            @map("voided_at") @db.Timestamptz(6)
  voidedByMembershipId String?              @map("voided_by_membership_id") @db.Uuid
  voidReason           String?              @map("void_reason") @db.Text
  replacedByCode       String?              @map("replaced_by_code") @db.Char(8)
  replacesCode         String?              @map("replaces_code") @db.Char(8)
  exportsCount         Int                  @default(0) @map("exports_count")
  firstExportedAt      DateTime?            @map("first_exported_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bottlingBatch BottlingBatch @relation(fields: [bottlingBatchId], references: [id], onDelete: Restrict)

  @@index([lotId, serial])
  @@index([lotId, status])
  @@map("bottle_units")
}

/// Exportación de códigos para la imprenta (§7.2): ZIP generado en el worker.
model BottleCodeExport {
  id                    String    @id @default(uuid()) @db.Uuid
  lotId                 String    @map("lot_id") @db.Uuid
  format                String    @db.VarChar(10)
  fromSerial            Int?      @map("from_serial")
  toSerial              Int?      @map("to_serial")
  options               Json      @default("{}") @db.JsonB
  /// `PENDING` | `READY` | `FAILED`
  status                String    @default("PENDING") @db.VarChar(10)
  rows                  Int       @default(0)
  storageKey            String?   @map("storage_key") @db.VarChar(500)
  error                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@map("bottle_code_exports")
}

/// Corrección compensatoria (§9, EA-06): el original nunca se pierde.
model TraceCorrection {
  id                    String   @id @default(uuid()) @db.Uuid
  lotId                 String?  @map("lot_id") @db.Uuid
  wineryId              String   @map("winery_id") @db.Uuid
  targetType            String   @map("target_type") @db.VarChar(30)
  targetId              String   @map("target_id") @db.Uuid
  /// `AMEND` | `VOID`
  kind                  String   @db.VarChar(10)
  changes               Json     @default("[]") @db.JsonB
  reason                String   @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@index([targetType, targetId])
  @@map("trace_corrections")
}

/// Incidencia de cumplimiento (§2.6.8): bloquea embotellar y cerrar el expediente.
model LotComplianceIssue {
  id                     String    @id @default(uuid()) @db.Uuid
  lotId                  String    @map("lot_id") @db.Uuid
  code                   String    @db.VarChar(60)
  message                String    @db.Text
  /// `MIGRATION` | `CORRECTION` | `RULES_REEVALUATION`
  source                 String    @db.VarChar(30)
  details                Json      @default("[]") @db.JsonB
  detectedAt             DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByCorrectionId String?   @map("resolved_by_correction_id") @db.Uuid

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, resolvedAt])
  @@map("lot_compliance_issues")
}

/// Archivo privado o público del lote (§11.5).
model LotAttachment {
  id                    String   @id @default(uuid()) @db.Uuid
  lotId                 String   @map("lot_id") @db.Uuid
  kind                  String   @db.VarChar(20)
  title                 String   @db.VarChar(200)
  key                   String   @db.VarChar(500)
  mimeType              String?  @map("mime_type") @db.VarChar(100)
  sizeBytes             Int?     @map("size_bytes")
  sha256                String?  @db.Char(64)
  /// `PRIVATE` | `PUBLIC`
  visibility            String   @default("PRIVATE") @db.VarChar(10)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@map("lot_attachments")
}

/// Expediente del lote (§10): hash SHA-256 del JSON canónico (RFC 8785).
model LotDossier {
  lotId                String    @id @map("lot_id") @db.Uuid
  schema               String    @default("doc-dossier/1") @db.VarChar(30)
  /// `OPEN` | `CLOSED`
  status               String    @default("OPEN") @db.VarChar(10)
  hash                 String?   @db.Char(64)
  canonical            String?   @db.Text
  bottleCount          Int?      @map("bottle_count")
  bottleMerkleRoot     String?   @map("bottle_merkle_root") @db.Char(64)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId String?   @map("closed_by_membership_id") @db.Uuid

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("lot_dossiers")
}

/// Pesajes anteriores a la Ola 2 pendientes de su lote (relleno §2.6): la
/// migración los encola y la API los procesa al arrancar (`LotBackfillRunner`).
model LotBackfillPending {
  harvestBatchId String   @id @map("harvest_batch_id") @db.Uuid
  enqueuedAt     DateTime @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  attempts       Int      @default(0)
  lastError      String?  @map("last_error") @db.Text

  @@map("lot_backfill_pending")
}
