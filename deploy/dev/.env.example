# =============================================================================
# Drinks on Chain · backend · entorno de DESARROLLO del servidor
#
# Copia en el servidor como ~/doc-dev/.env (fuera del código, chmod 600).
# deploy.sh lo pasa con --env-file a deploy/dev/compose.yml.
# Genera cada secreto EN EL SERVIDOR y no lo imprimas:  openssl rand -hex 32
# Usa valores hexadecimales: van dentro de URL (DATABASE_URL, REDIS_URL).
# =============================================================================

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=postgres
# Si reutilizas el volumen existente, debe ser la contraseña con la que se
# creó ese volumen (o cámbiala antes con ALTER USER ... PASSWORD ...).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinks_on_chain_db

# --- Redis (requirepass) ------------------------------------------------------
REDIS_PASSWORD=change-me

# --- MinIO (almacenamiento de objetos privado) --------------------------------
# La API usa estas mismas credenciales si no se definen S3_ACCESS_KEY y
# S3_SECRET_KEY; el bucket (S3_BUCKET, doc-dev-uploads) se crea al arrancar.
MINIO_ROOT_USER=doc-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# S3_BUCKET=doc-dev-uploads
# Host público de MinIO para que el navegador abra las URL firmadas (un
# server de nginx que haga proxy a minio:9000). Sin definir, las URL apuntan
# a http://minio:9000 (solo sirven dentro de la red interna).
# S3_PUBLIC_ENDPOINT=https://storage-dev.example.com
# STORAGE_DRIVER=s3                 # local = carpeta en el volumen uploads

# --- API ----------------------------------------------------------------------
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-32-characters-long
# JWT_EXPIRES_IN=900s              # acceso de 15 min (un valor mayor se recorta)
# TRUST_PROXY=1                     # nginx delante (ya es el valor por defecto en compose)
# Orígenes exactos separados por comas, sin comodines (producción de cada app,
# previews concretos y localhost del equipo si hace falta).
CORS_ALLOWED_ORIGINS=https://erp.example.com,http://localhost:3002
# Solo con STORAGE_DRIVER=local: origen público de la API para las URL firmadas
# STORAGE_BASE_URL=https://api-dev.example.com
# true = prisma migrate deploy al arrancar la API (recomendado en desarrollo)
RUN_MIGRATIONS=true
# API_NODE_ENV=production
# Swagger UI (/docs) y /docs-json; en desarrollo quedan activos (por defecto
# true en este compose; en producción, apagados si no se definen)
# SWAGGER_ENABLED=true
# LOG_FORMAT=json

# --- Semilla (docker compose ... exec api node dist/seed.js) -------------------
# La API las recibe en su entorno solo para poder ejecutar la semilla con exec;
# la API no las lee. Ver README, "Datos de demostración". Genera las
# contraseñas EN EL SERVIDOR (openssl rand -hex 16) y no las imprimas.
SUPERADMIN_EMAIL=change-me@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME="Superadministrador de la plataforma"
SEED_DEMO=true
SEED_DEMO_PASSWORD=change-me
# Secreto TOTP (base32) del personal interno de demo; sin él, lo inscriben al entrar
# SEED_DEMO_TOTP_SECRET=

# --- Cuenta, segundo factor e invitaciones (Ola 1) ----------------------------
# Clave de cifrado de los secretos TOTP en la base. GENÉRALA EN EL SERVIDOR:
#   openssl rand -base64 32
# Sin ella la API arranca con una clave derivada de JWT_SECRET y un aviso.
MFA_ENCRYPTION_KEY=change-me
# Captcha (Cloudflare Turnstile). Por defecto (compose) la clave de prueba que
# siempre valida; la real, cuando exista el sitio en Cloudflare.
# TURNSTILE_SECRET_KEY=
# URL de cada app en los enlaces de los correos (por defecto, las de Vercel)
# APP_URL_ERP=https://drinks-on-chain-erp.vercel.app
# APP_URL_BACKOFFICE=https://drinks-on-chain-backoffice.vercel.app
# APP_URL_POS=

# --- Puertos publicados en 127.0.0.1 -----------------------------------------
# API_HOST_PORT=3000          # nginx hace proxy a 127.0.0.1:3000
# MAILPIT_UI_HOST_PORT=8025   # acceso por túnel SSH

# --- Volúmenes ----------------------------------------------------------------
# Para reutilizar los volúmenes que ya existen en el servidor:
POSTGRES_VOLUME_NAME=drinks-on-chain-back_postgres_data
POSTGRES_VOLUME_EXTERNAL=true
REDIS_VOLUME_NAME=drinks-on-chain-back_redis_data
REDIS_VOLUME_EXTERNAL=true
# Sin definir = volúmenes nuevos gestionados por compose (doc-dev_*):
# UPLOADS_VOLUME_NAME=doc-dev_uploads
# MAILPIT_VOLUME_NAME=doc-dev_mailpit_data
# MINIO_VOLUME_NAME=doc-dev_minio_data

# --- Correo (opcionales): por defecto, Mailpit de este compose -----------------
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Drinks on Chain (desarrollo) <no-reply@dev.drinksonchain.local>

# --- Worker (opcionales; ver docs/arquitectura/outbox.md) ---------------------
# WORKER_CONCURRENCY=5
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_RETENTION_DAYS=7

# --- deploy.sh (opcionales) -----------------------------------------------------
# DEPLOY_HEALTH_TIMEOUT=180   # segundos esperando a que la API y el worker queden healthy
# DEPLOY_KEEP_RELEASES=3
# DEPLOY_HEALTH_SERVICES="api worker"
