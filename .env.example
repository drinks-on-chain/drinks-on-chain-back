# =============================================================================
# Drinks on Chain · backend · variables de entorno (desarrollo local)
#
#   cp .env.example .env      # y cambia cada "change-me"
#
# Lo leen: la API (@nestjs/config), Prisma CLI y docker compose (interpolación
# de docker-compose.yml). Nunca subas el .env al repositorio.
# Genera contraseñas y secretos aptos para URL con:  openssl rand -hex 32
# La validación está en src/config/env.validation.ts.
# =============================================================================

# --- Servidor HTTP -----------------------------------------------------------
NODE_ENV=development
# 4000 en local: el 3000 lo usa el sitio de bodegas y el 3002 el ERP
PORT=4000
APP_NAME="Drinks on Chain Backend"

# --- Servicios de docker compose (solo en 127.0.0.1) -------------------------
# Credenciales con las que se crean los contenedores. Si las cambias después
# de crear el volumen de Postgres, la contraseña antigua sigue vigente.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinks_on_chain_db
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=doc-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Puertos publicados en 127.0.0.1 (opcionales; estos son los valores por defecto)
# POSTGRES_HOST_PORT=5435
# REDIS_HOST_PORT=6379
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# API_HOST_PORT=4000

# --- Base de datos (obligatoria) ---------------------------------------------
# Misma contraseña que POSTGRES_PASSWORD. Puerto 5435 = Postgres de compose.
DATABASE_URL="postgresql://postgres:change-me@localhost:5435/drinks_on_chain_db?schema=public"

# --- Redis (obligatoria) -----------------------------------------------------
# Misma contraseña que REDIS_PASSWORD.
REDIS_URL="redis://:change-me@localhost:6379"

# --- JWT (obligatorias, mínimo 32 caracteres) --------------------------------
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-another-32-characters-long
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS --------------------------------------------------------------------
# Orígenes exactos separados por comas (esquema://host[:puerto], sin ruta).
# Sin comodines: "*" se rechaza. Obligatoria en producción.
# Vacía fuera de producción = ERP (3002) y plantilla (3009) en localhost.
CORS_ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3009"

# --- Swagger / OpenAPI -------------------------------------------------------
# /docs (UI) y /docs-json. false en producción; el contrato es openapi.json.
SWAGGER_ENABLED=true

# --- Almacenamiento de archivos ----------------------------------------------
# local (carpeta servida en /uploads) · s3 llegará con la Ola 0 (0.9, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Opcional: por defecto http://localhost:<PORT>/uploads
# STORAGE_BASE_URL=http://localhost:4000/uploads

# --- Superadministrador inicial (solo `pnpm prisma:seed`) --------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME="Platform Super Administrator"

# --- Stellar / Soroban (opcional hasta la Ola 3) -----------------------------
# STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_RELAYER_SECRET_KEY=            # semilla S... de 56 caracteres
# STELLAR_INDEXER_POLL_INTERVAL_MS=5000
# STELLAR_INDEXER_START_LEDGER=0

# --- Solo para la imagen de Docker -------------------------------------------
# true = `prisma migrate deploy` antes de arrancar (docker/entrypoint.sh)
# RUN_MIGRATIONS=false
