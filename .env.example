# Servidor HTTP
PORT=3000
NODE_ENV=development
APP_NAME="Drinks on Chain Backend"

# Base de Datos PostgreSQL (Local o Supabase)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/drinks_on_chain_db?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Autenticación JWT
JWT_SECRET="super-secret-key-drinks-on-chain-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="super-secret-refresh-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# Stellar / Soroban Blockchain
STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_RELAYER_SECRET_KEY="S0000000000000000000000000000000000000000000000000000000"

# Contratos Soroban
CONTRACT_PRODUCER_REGISTRY="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
CONTRACT_BATCH_ANCHOR="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
CONTRACT_PRODUCT_NFT="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
CONTRACT_CLAIM_ESCROW="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Dynamic Wallets
DYNAMIC_ENVIRONMENT_ID="dynamic-env-placeholder"
DYNAMIC_API_KEY="dynamic-key-placeholder"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Pasarela de Pagos (Banco API)
PAYMENT_BANK_API_KEY="bank-api-key-placeholder"
PAYMENT_BANK_API_SECRET="bank-api-secret-placeholder"
PAYMENT_BANK_BASE_URL="https://api.banco.bo/v1"
PAYMENT_BANK_WEBHOOK_SECRET="bank-webhook-secret-placeholder"

# Indexer
STELLAR_INDEXER_POLL_INTERVAL_MS=5000
STELLAR_INDEXER_START_LEDGER=0

# Seguridad / CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4200"
