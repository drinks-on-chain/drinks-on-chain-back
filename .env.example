# =============================================================================
# Drinks on Chain · backend · variables de entorno (desarrollo local)
#
#   cp .env.example .env      # y cambia cada "change-me"
#
# Lo leen: la API (@nestjs/config), Prisma CLI y docker compose (interpolación
# de docker-compose.yml). Nunca subas el .env al repositorio.
# Genera contraseñas y secretos aptos para URL con:  openssl rand -hex 32
# La validación está en src/config/env.validation.ts.
# =============================================================================

# --- Servidor HTTP -----------------------------------------------------------
NODE_ENV=development
# 4000 en local: el 3000 lo usa el sitio de bodegas y el 3002 el ERP
PORT=4000
APP_NAME="Drinks on Chain Backend"

# --- Servicios de docker compose (solo en 127.0.0.1) -------------------------
# Credenciales con las que se crean los contenedores. Si las cambias después
# de crear el volumen de Postgres, la contraseña antigua sigue vigente.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinks_on_chain_db
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=doc-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Puertos publicados en 127.0.0.1 (opcionales; estos son los valores por defecto)
# POSTGRES_HOST_PORT=5435
# REDIS_HOST_PORT=6379
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# API_HOST_PORT=4000

# --- Base de datos (obligatoria) ---------------------------------------------
# Misma contraseña que POSTGRES_PASSWORD. Puerto 5435 = Postgres de compose.
DATABASE_URL="postgresql://postgres:change-me@localhost:5435/drinks_on_chain_db?schema=public"

# --- Redis (obligatoria) -----------------------------------------------------
# Misma contraseña que REDIS_PASSWORD.
REDIS_URL="redis://:change-me@localhost:6379"

# --- Sesión (obligatorias, mínimo 32 caracteres) ------------------------------
# Ver docs/arquitectura/identidad.md. Acceso de 15 min (un valor mayor se recorta).
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=900s
# Clave HMAC de la cadena de refrescos (cookie doc_rt), distinta de JWT_SECRET
JWT_REFRESH_SECRET=change-me-another-32-characters-long
# Renovación deslizante (días) y periodo de gracia de la rotación (segundos)
# SESSION_TTL_STAFF_DAYS=7
# SESSION_TTL_CONSUMER_DAYS=30
# REFRESH_GRACE_SECONDS=20
# SE-05: 403 ORG_NOT_ACTIVE en el ERP con la bodega no ACTIVE (Ola 1)
# FEATURE_ENFORCE_ACTIVE_ORG=false

# --- IP real y límites de peticiones (SE-06, IAM-07) --------------------------
# Saltos de proxy de confianza: 1 detrás de nginx; vacío en local sin proxy.
# TRUST_PROXY=
# RATE_LIMIT_GLOBAL_PER_MINUTE=300    # toda la API, por IP
# RATE_LIMIT_AUTH_PER_MINUTE=20       # cada ruta de /auth/*, por IP
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_SIGNUP_PER_MINUTE=5
# RATE_LIMIT_REFRESH_PER_MINUTE=30
# LOGIN_LOCK_EMAIL_THRESHOLD=5        # fallos antes del bloqueo progresivo
# LOGIN_LOCK_IP_THRESHOLD=20

# --- CORS --------------------------------------------------------------------
# Orígenes exactos separados por comas (esquema://host[:puerto], sin ruta).
# Sin comodines: "*" se rechaza. Obligatoria en producción.
# Vacía fuera de producción = ERP (3002) y plantilla (3009) en localhost.
CORS_ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3009"

# --- Swagger / OpenAPI -------------------------------------------------------
# /docs (UI) y /docs-json. false en producción; el contrato es openapi.json.
SWAGGER_ENABLED=true

# --- Almacenamiento de archivos ----------------------------------------------
# local (carpeta servida en /uploads) · s3 llegará con la Ola 0 (0.9, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Opcional: por defecto http://localhost:<PORT>/uploads
# STORAGE_BASE_URL=http://localhost:4000/uploads

# --- Superadministrador inicial (solo `pnpm prisma:seed`) --------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME="Platform Super Administrator"

# --- Stellar / Soroban (opcional hasta la Ola 3) -----------------------------
# STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_RELAYER_SECRET_KEY=            # semilla S... de 56 caracteres
# STELLAR_INDEXER_POLL_INTERVAL_MS=5000
# STELLAR_INDEXER_START_LEDGER=0

# --- Worker: outbox, colas y tareas programadas (opcionales) ------------------
# Lo lee el proceso worker (pnpm start:worker:dev); validación en
# src/worker/worker.config.ts. Ver docs/arquitectura/outbox.md.
# QUEUE_PREFIX=doc                    # prefijo de las claves de BullMQ en Redis
# WORKER_CONCURRENCY=5                # trabajos simultáneos por cola
# JOB_ATTEMPTS=5                      # intentos de cada trabajo (backoff exponencial)
# JOB_BACKOFF_MS=5000
# OUTBOX_RELAY_INTERVAL_MS=1000       # cada cuánto busca eventos pendientes
# OUTBOX_RELAY_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=10              # intentos de publicar un evento antes de FAILED
# OUTBOX_RETRY_BASE_MS=2000           # espera base · 2^(intento-1), con tope:
# OUTBOX_RETRY_MAX_MS=600000
# OUTBOX_LOCK_TIMEOUT_MS=60000        # PROCESSING abandonado → se vuelve a reclamar
# OUTBOX_RETENTION_DAYS=7             # la limpieza horaria borra DONE más antiguos
# WORKER_HEARTBEAT_FILE=/tmp/doc-worker.heartbeat
# WORKER_HEARTBEAT_INTERVAL_MS=10000
# WORKER_HEARTBEAT_MAX_AGE_MS=60000   # healthcheck: latido más viejo = no sano

# --- Solo para la imagen de Docker -------------------------------------------
# true = `prisma migrate deploy` antes de arrancar (docker/entrypoint.sh)
# RUN_MIGRATIONS=false
