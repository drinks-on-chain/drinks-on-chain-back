# =============================================================================
# Drinks on Chain · backend · variables de entorno (desarrollo local)
#
#   cp .env.example .env      # y cambia cada "change-me"
#
# Lo leen: la API (@nestjs/config), Prisma CLI y docker compose (interpolación
# de docker-compose.yml). Nunca subas el .env al repositorio.
# Genera contraseñas y secretos aptos para URL con:  openssl rand -hex 32
# La validación está en src/config/env.validation.ts.
# =============================================================================

# --- Servidor HTTP -----------------------------------------------------------
NODE_ENV=development
# 4000 en local: el 3000 lo usa el sitio de bodegas y el 3002 el ERP
PORT=4000
APP_NAME="Drinks on Chain Backend"

# --- Servicios de docker compose (solo en 127.0.0.1) -------------------------
# Credenciales con las que se crean los contenedores. Si las cambias después
# de crear el volumen de Postgres, la contraseña antigua sigue vigente.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinks_on_chain_db
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=doc-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Puertos publicados en 127.0.0.1 (opcionales; estos son los valores por defecto)
# POSTGRES_HOST_PORT=5435
# REDIS_HOST_PORT=6379
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# API_HOST_PORT=4000

# --- Base de datos (obligatoria) ---------------------------------------------
# Misma contraseña que POSTGRES_PASSWORD. Puerto 5435 = Postgres de compose.
DATABASE_URL="postgresql://postgres:change-me@localhost:5435/drinks_on_chain_db?schema=public"

# --- Redis (obligatoria) -----------------------------------------------------
# Misma contraseña que REDIS_PASSWORD.
REDIS_URL="redis://:change-me@localhost:6379"

# --- Sesión (obligatorias, mínimo 32 caracteres) ------------------------------
# Ver docs/arquitectura/identidad.md. Acceso de 15 min (un valor mayor se recorta).
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=900s
# Clave HMAC de la cadena de refrescos (cookie doc_rt), distinta de JWT_SECRET
JWT_REFRESH_SECRET=change-me-another-32-characters-long
# Renovación deslizante (días) y periodo de gracia de la rotación (segundos)
# SESSION_TTL_STAFF_DAYS=7
# SESSION_TTL_CONSUMER_DAYS=30
# REFRESH_GRACE_SECONDS=20
# SE-05: 403 ORG_NOT_ACTIVE en el ERP con la bodega no ACTIVE (activo por
# defecto desde la Ola 1; false = solo aviso en los logs)
# FEATURE_ENFORCE_ACTIVE_ORG=true

# --- Cuenta, segundo factor e invitaciones (Ola 1; docs/arquitectura/identidad.md)
# Clave con la que se cifran los secretos TOTP en la base (openssl rand -base64 32).
# Sin ella se deriva de JWT_SECRET (aviso al arrancar); obligatoria de hecho en producción.
MFA_ENCRYPTION_KEY=change-me-at-least-32-characters-long
# Cloudflare Turnstile: clave de prueba que siempre valida (sin red). Obligatoria en producción.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# URL de cada app en los enlaces de los correos (por defecto, localhost)
# APP_URL_BODEGAS=http://localhost:3000     # sitio de bodegas (/unirse/verificar)
# APP_URL_ERP=http://localhost:3002
# APP_URL_BACKOFFICE=http://localhost:3003
# APP_URL_POS=http://localhost:3004
# APP_URL_MARKETPLACE=http://localhost:3005
# URL base del pasaporte público: el QR apunta a {PASSPORT_BASE_URL}/b/{código}
# (por defecto, APP_URL_MARKETPLACE)
# PASSPORT_BASE_URL=http://localhost:3005

# --- IP real y límites de peticiones (SE-06, IAM-07) --------------------------
# Saltos de proxy de confianza: 1 detrás de nginx; vacío en local sin proxy.
# TRUST_PROXY=
# IP del cliente firmada por el proxy de las apps (O1-OPS-1): el mismo valor
# que PROXY_SHARED_SECRET de cada app Next. Varios separados por comas para
# rotar sin corte (nuevo,anterior). Vacío = desactivado. openssl rand -hex 32
# PROXY_SHARED_SECRET=
# RATE_LIMIT_GLOBAL_PER_MINUTE=300    # toda la API, por IP
# RATE_LIMIT_AUTH_PER_MINUTE=20       # cada ruta de /auth/*, por IP
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_SIGNUP_PER_MINUTE=5
# RATE_LIMIT_REFRESH_PER_MINUTE=30
# RATE_LIMIT_APPLICATION_PER_MINUTE=5 # formulario público de solicitud de alta
# LOGIN_LOCK_EMAIL_THRESHOLD=5        # fallos antes del bloqueo progresivo
# LOGIN_LOCK_IP_THRESHOLD=20

# --- Lista de espera (POST /v1/public/waitlist; ver README, "Lista de espera") -
# Inscripciones por IP real (por minuto y por hora) y por correo (por hora).
# Pensados para un evento, donde mucha gente comparte la misma red.
# WAITLIST_LIMIT_IP_MINUTE=20
# WAITLIST_LIMIT_IP_HOUR=300
# WAITLIST_LIMIT_EMAIL_HOUR=3
# true = exige `captchaToken` válido (TURNSTILE_SECRET_KEY real); por defecto,
# solo campo trampa y límites
# WAITLIST_CAPTCHA_REQUIRED=false

# --- CORS --------------------------------------------------------------------
# Orígenes exactos separados por comas (esquema://host[:puerto], sin ruta).
# Sin comodines: "*" se rechaza. Obligatoria en producción.
# Vacía fuera de producción = ERP (3002) y plantilla (3009) en localhost.
CORS_ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3009"

# --- Swagger / OpenAPI -------------------------------------------------------
# /docs (UI) y /docs-json. Sin definir: activo fuera de producción y apagado
# en producción (SE-08). El contrato versionado es openapi.json.
SWAGGER_ENABLED=true

# --- Logs --------------------------------------------------------------------
# json (una línea por entrada, con correlationId, sid y org) o text (legible)
# LOG_FORMAT=json

# --- Almacenamiento de objetos privado (OPS-06, SE-04) -----------------------
# s3 = MinIO de docker compose (127.0.0.1:9000) · local = carpeta en disco.
# Nada es público: los archivos se leen con URL firmadas de corta vida.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=                  # si el navegador ve otro host que la API
S3_REGION=us-east-1
S3_BUCKET=doc-local-uploads           # se crea al arrancar si no existe
# Mismas credenciales que MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ACCESS_KEY=doc-minio
S3_SECRET_KEY=change-me-min-8-chars
S3_FORCE_PATH_STYLE=true
# STORAGE_SIGNED_URL_TTL_SECONDS=900   # vida de las URL firmadas (máx. 3600)
# Driver local (STORAGE_DRIVER=local):
# STORAGE_LOCAL_PATH=./uploads
# STORAGE_BASE_URL=http://localhost:4000   # origen público de la API
# STORAGE_SIGNING_SECRET=              # por defecto, derivado de JWT_SECRET

# --- Correo (lo envía el worker por la cola `email`) -------------------------
# Por defecto, Mailpit de docker compose (UI en http://127.0.0.1:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Drinks on Chain (local) <no-reply@drinksonchain.local>"
# MAIL_REPLY_TO=

# --- Semilla (pnpm seed; en la imagen, node dist/seed.js) --------------------
# Ver README, "Datos de demostración". Nunca hay contraseñas por defecto: sin
# SUPERADMIN_EMAIL y SUPERADMIN_PASSWORD no se crea el superusuario, y
# SEED_DEMO=true exige SEED_DEMO_PASSWORD. Mínimo 10 caracteres; la semilla
# rechaza los change-me (openssl rand -hex 16).
SUPERADMIN_EMAIL=change-me@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME="Superadministrador de la plataforma"
# true = personal interno, bodegas y trazabilidad de los mocks (solo local y desarrollo)
SEED_DEMO=true
# Contraseña de todas las personas de demostración
SEED_DEMO_PASSWORD=change-me
# Secreto TOTP (base32) del personal interno de demo inscrito. Para usar el de
# los mocks: DRINKSONCHAINDEMOTOTPKEY. Vacío = lo inscriben al entrar.
# SEED_DEMO_TOTP_SECRET=

# --- Stellar / Soroban (opcional hasta la Ola 3) -----------------------------
# STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_RELAYER_SECRET_KEY=            # semilla S... de 56 caracteres
# STELLAR_INDEXER_POLL_INTERVAL_MS=5000
# STELLAR_INDEXER_START_LEDGER=0

# --- Worker: outbox, colas y tareas programadas (opcionales) ------------------
# Lo lee el proceso worker (pnpm start:worker:dev); validación en
# src/worker/worker.config.ts. Ver docs/arquitectura/outbox.md.
# QUEUE_PREFIX=doc                    # prefijo de las claves de BullMQ en Redis (api y worker: el mismo)
# WORKER_CONCURRENCY=5                # trabajos simultáneos por cola
# JOB_ATTEMPTS=5                      # intentos de cada trabajo (backoff exponencial)
# JOB_BACKOFF_MS=5000
# OUTBOX_RELAY_INTERVAL_MS=1000       # cada cuánto busca eventos pendientes
# OUTBOX_RELAY_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=10              # intentos de publicar un evento antes de FAILED
# OUTBOX_RETRY_BASE_MS=2000           # espera base · 2^(intento-1), con tope:
# OUTBOX_RETRY_MAX_MS=600000
# OUTBOX_LOCK_TIMEOUT_MS=60000        # PROCESSING abandonado → se vuelve a reclamar
# OUTBOX_RETENTION_DAYS=7             # la limpieza horaria borra DONE más antiguos
# WORKER_HEARTBEAT_FILE=/tmp/doc-worker.heartbeat
# WORKER_HEARTBEAT_INTERVAL_MS=10000
# WORKER_HEARTBEAT_MAX_AGE_MS=60000   # healthcheck: latido más viejo = no sano; caducidad del latido en Redis

# --- Solo para la imagen de Docker -------------------------------------------
# true = `prisma migrate deploy` antes de arrancar (docker/entrypoint.sh)
# RUN_MIGRATIONS=false
